---
import BaseLayout from '../layouts/BaseLayout.astro';

// Navbar
import N1 from '../sections/navbar/N1.astro';
import N2 from '../sections/navbar/N2.astro';
import N3 from '../sections/navbar/N3.astro';
import N4 from '../sections/navbar/N4.astro';

// Hero
import H1 from '../sections/hero/H1.astro';
import H2 from '../sections/hero/H2.astro';
import H3 from '../sections/hero/H3.astro';
import H4 from '../sections/hero/H4.astro';

// Keunggulan
import K1 from '../sections/keunggulan/K1.astro';
import K2 from '../sections/keunggulan/K2.astro';
import K3 from '../sections/keunggulan/K3.astro';

// Layanan
import S1 from '../sections/layanan/S1.astro';
import S2 from '../sections/layanan/S2.astro';
import S3 from '../sections/layanan/S3.astro';
import S4 from '../sections/layanan/S4.astro';

// Langkah
import P1 from '../sections/langkah/P1.astro';
import P2 from '../sections/langkah/P2.astro';
import P3 from '../sections/langkah/P3.astro';

// Galeri
import G1 from '../sections/galeri/G1.astro';
import G2 from '../sections/galeri/G2.astro';
import G3 from '../sections/galeri/G3.astro';

// Ulasan
import U1 from '../sections/ulasan/U1.astro';
import U2 from '../sections/ulasan/U2.astro';
import U3 from '../sections/ulasan/U3.astro';

// Biaya
import B1 from '../sections/biaya/B1.astro';
import B2 from '../sections/biaya/B2.astro';
import B3 from '../sections/biaya/B3.astro';

// Tanya Jawab
import Q1 from '../sections/tanya-jawab/Q1.astro';
import Q2 from '../sections/tanya-jawab/Q2.astro';
import Q3 from '../sections/tanya-jawab/Q3.astro';

// Profil
import R1 from '../sections/profil/R1.astro';
import R2 from '../sections/profil/R2.astro';
import R3 from '../sections/profil/R3.astro';

// Lokasi
import L1 from '../sections/lokasi/L1.astro';
import L2 from '../sections/lokasi/L2.astro';
import L3 from '../sections/lokasi/L3.astro';

// CTA Akhir
import C1 from '../sections/cta/C1.astro';
import C2 from '../sections/cta/C2.astro';
import C3 from '../sections/cta/C3.astro';

// Footer
import F1 from '../sections/footer/F1.astro';
import F2 from '../sections/footer/F2.astro';
import F3 from '../sections/footer/F3.astro';
import F4 from '../sections/footer/F4.astro';

// Standar Datasets
import { standarNavbar } from '../schema/navbar';
import { standarHero } from '../schema/hero';
import { standarKeunggulan } from '../schema/keunggulan';
import { standarLayanan } from '../schema/layanan';
import { standarLangkah } from '../schema/langkah';
import { standarGaleri } from '../schema/galeri';
import { standarUlasan } from '../schema/ulasan';
import { standarBiaya } from '../schema/biaya';
import { standarTanyaJawab } from '../schema/tanya-jawab';
import { standarProfil } from '../schema/profil';
import { standarLokasi } from '../schema/lokasi';
import { standarCta } from '../schema/cta';
import { standarFooter } from '../schema/footer';

const configuredPreviewBaseUrl = import.meta.env.PUBLIC_PREVIEW_BASE_URL?.trim() ?? '';
---

<BaseLayout title="Studio Perakit Halaman">
  <div class="composer-page" data-preview-base-url={configuredPreviewBaseUrl}>
    <!-- Studio Header & Toolbar -->
    <header class="composer-toolbar" id="composer-toolbar" aria-label="Bilah Kontrol Perakit">
      <div class="wf-container composer-toolbar-top">
        <div class="composer-meta">
          <h1 class="composer-title">Studio Perakit Halaman</h1>
          <p class="composer-subtitle">Rakit kombinasi section wireframe, atur urutan, dan hasilkan tautan pratinjau klien.</p>
        </div>

        <div class="composer-top-actions">
          <!-- Viewport Toggle -->
          <div class="composer-control-group" role="group" aria-label="Simulasi Lebar Layar">
            <span class="composer-group-label">Kanvas:</span>
            <button type="button" class="wf-btn composer-vp-btn active" id="vp-desktop-btn" aria-pressed="true">
              Desktop
            </button>
            <button type="button" class="wf-btn composer-vp-btn" id="vp-mobile-btn" aria-pressed="false">
              Mobile 390px
            </button>
          </div>

          <!-- Toggle Deck Visibility -->
          <button type="button" class="wf-btn composer-deck-toggle" id="toggle-deck-btn" aria-expanded="true" aria-controls="composer-deck">
            Sembunyikan Panel Kontrol
          </button>
        </div>
      </div>

      <!-- Presets & Client Export Bar -->
      <div class="wf-container composer-toolbar-bottom">
        <div class="composer-preset-row">
          <span class="composer-group-label">Preset Cepat:</span>
          <div class="composer-preset-buttons">
            <button type="button" class="wf-btn composer-preset-btn active" data-preset="lengkap">Lengkap (13 Section)</button>
            <button type="button" class="wf-btn composer-preset-btn" data-preset="jasa">Jasa & Layanan</button>
            <button type="button" class="wf-btn composer-preset-btn" data-preset="katalog">Katalog & Produk</button>
            <button type="button" class="wf-btn composer-preset-btn" data-preset="korporat">Profil Korporat</button>
            <button type="button" class="wf-btn composer-preset-btn" data-preset="ringkas">Landing Page Ringkas</button>
          </div>
        </div>

        <div class="composer-export-row">
          <div class="composer-recipe-box">
            <span class="composer-group-label">Kode Resep:</span>
            <code class="composer-recipe-string" id="composer-recipe-display">N1,H1,R1,K1,S1,P1,G1,U1,B1,Q1,L1,C1,F1</code>
          </div>

          <div class="composer-export-buttons">
            <button type="button" class="wf-btn wf-btn-primary composer-copy-btn" id="btn-copy-preview">
              Salin Link Klien
            </button>
            <a href="/pratinjau" target="_blank" rel="noopener noreferrer" class="wf-btn wf-btn-secondary composer-open-btn" id="btn-open-preview">
              Buka Pratinjau Klien
            </a>
          </div>
        </div>
      </div>
    </header>

    <!-- Section Control Deck (Collapsible) -->
    <section class="wf-container composer-deck-section" id="composer-deck" aria-label="Daftar Pengaturan Section">
      <div class="composer-deck-header">
        <h2 class="composer-deck-title">Susunan Section Aktif</h2>
        <span class="composer-deck-hint">Centang untuk mengaktifkan, gunakan panah untuk mengatur urutan susunan tampilan.</span>
      </div>

      <div class="composer-deck-list" id="composer-deck-list">
        <!-- Rendered dynamically by inline script -->
      </div>
    </section>

    <!-- Canvas Live Preview Area -->
    <main class="composer-canvas-area" id="composer-canvas-area">
      <div class="composer-viewport" id="composer-viewport">
        <div class="composer-canvas" id="composer-canvas">
          <!-- Navbar Variants -->
          <div class="composer-item-wrap" data-variant-code="N1" data-kind="navbar">
            <N1 data={standarNavbar} id="live-n1" />
          </div>
          <div class="composer-item-wrap" data-variant-code="N2" data-kind="navbar">
            <N2 data={standarNavbar} id="live-n2" />
          </div>
          <div class="composer-item-wrap" data-variant-code="N3" data-kind="navbar">
            <N3 data={standarNavbar} id="live-n3" />
          </div>
          <div class="composer-item-wrap" data-variant-code="N4" data-kind="navbar">
            <N4 data={standarNavbar} id="live-n4" />
          </div>

          <!-- Hero Variants -->
          <div class="composer-item-wrap" data-variant-code="H1" data-kind="hero">
            <H1 data={standarHero} id="live-h1" />
          </div>
          <div class="composer-item-wrap" data-variant-code="H2" data-kind="hero">
            <H2 data={standarHero} id="live-h2" />
          </div>
          <div class="composer-item-wrap" data-variant-code="H3" data-kind="hero">
            <H3 data={standarHero} id="live-h3" />
          </div>
          <div class="composer-item-wrap" data-variant-code="H4" data-kind="hero">
            <H4 data={standarHero} id="live-h4" />
          </div>

          <!-- Profil Variants -->
          <div class="composer-item-wrap" data-variant-code="R1" data-kind="profil">
            <R1 data={standarProfil} id="live-r1" />
          </div>
          <div class="composer-item-wrap" data-variant-code="R2" data-kind="profil">
            <R2 data={standarProfil} id="live-r2" />
          </div>
          <div class="composer-item-wrap" data-variant-code="R3" data-kind="profil">
            <R3 data={standarProfil} id="live-r3" />
          </div>

          <!-- Keunggulan Variants -->
          <div class="composer-item-wrap" data-variant-code="K1" data-kind="keunggulan">
            <K1 data={standarKeunggulan} id="live-k1" />
          </div>
          <div class="composer-item-wrap" data-variant-code="K2" data-kind="keunggulan">
            <K2 data={standarKeunggulan} id="live-k2" />
          </div>
          <div class="composer-item-wrap" data-variant-code="K3" data-kind="keunggulan">
            <K3 data={standarKeunggulan} id="live-k3" />
          </div>

          <!-- Layanan Variants -->
          <div class="composer-item-wrap" data-variant-code="S1" data-kind="layanan">
            <S1 data={standarLayanan} id="live-s1" />
          </div>
          <div class="composer-item-wrap" data-variant-code="S2" data-kind="layanan">
            <S2 data={standarLayanan} id="live-s2" />
          </div>
          <div class="composer-item-wrap" data-variant-code="S3" data-kind="layanan">
            <S3 data={standarLayanan} id="live-s3" />
          </div>
          <div class="composer-item-wrap" data-variant-code="S4" data-kind="layanan">
            <S4 data={standarLayanan} id="live-s4" />
          </div>

          <!-- Langkah Variants -->
          <div class="composer-item-wrap" data-variant-code="P1" data-kind="langkah">
            <P1 data={standarLangkah} id="live-p1" />
          </div>
          <div class="composer-item-wrap" data-variant-code="P2" data-kind="langkah">
            <P2 data={standarLangkah} id="live-p2" />
          </div>
          <div class="composer-item-wrap" data-variant-code="P3" data-kind="langkah">
            <P3 data={standarLangkah} id="live-p3" />
          </div>

          <!-- Galeri Variants -->
          <div class="composer-item-wrap" data-variant-code="G1" data-kind="galeri">
            <G1 data={standarGaleri} id="live-g1" />
          </div>
          <div class="composer-item-wrap" data-variant-code="G2" data-kind="galeri">
            <G2 data={standarGaleri} id="live-g2" />
          </div>
          <div class="composer-item-wrap" data-variant-code="G3" data-kind="galeri">
            <G3 data={standarGaleri} id="live-g3" />
          </div>

          <!-- Ulasan Variants -->
          <div class="composer-item-wrap" data-variant-code="U1" data-kind="ulasan">
            <U1 data={standarUlasan} id="live-u1" />
          </div>
          <div class="composer-item-wrap" data-variant-code="U2" data-kind="ulasan">
            <U2 data={standarUlasan} id="live-u2" />
          </div>
          <div class="composer-item-wrap" data-variant-code="U3" data-kind="ulasan">
            <U3 data={standarUlasan} id="live-u3" />
          </div>

          <!-- Biaya Variants -->
          <div class="composer-item-wrap" data-variant-code="B1" data-kind="biaya">
            <B1 data={standarBiaya} id="live-b1" />
          </div>
          <div class="composer-item-wrap" data-variant-code="B2" data-kind="biaya">
            <B2 data={standarBiaya} id="live-b2" />
          </div>
          <div class="composer-item-wrap" data-variant-code="B3" data-kind="biaya">
            <B3 data={standarBiaya} id="live-b3" />
          </div>

          <!-- Tanya Jawab Variants -->
          <div class="composer-item-wrap" data-variant-code="Q1" data-kind="tanya-jawab">
            <Q1 data={standarTanyaJawab} id="live-q1" />
          </div>
          <div class="composer-item-wrap" data-variant-code="Q2" data-kind="tanya-jawab">
            <Q2 data={standarTanyaJawab} id="live-q2" />
          </div>
          <div class="composer-item-wrap" data-variant-code="Q3" data-kind="tanya-jawab">
            <Q3 data={standarTanyaJawab} id="live-q3" />
          </div>

          <!-- Lokasi Variants -->
          <div class="composer-item-wrap" data-variant-code="L1" data-kind="lokasi">
            <L1 data={standarLokasi} id="live-l1" />
          </div>
          <div class="composer-item-wrap" data-variant-code="L2" data-kind="lokasi">
            <L2 data={standarLokasi} id="live-l2" />
          </div>
          <div class="composer-item-wrap" data-variant-code="L3" data-kind="lokasi">
            <L3 data={standarLokasi} id="live-l3" />
          </div>

          <!-- CTA Variants -->
          <div class="composer-item-wrap" data-variant-code="C1" data-kind="cta">
            <C1 data={standarCta} id="live-c1" />
          </div>
          <div class="composer-item-wrap" data-variant-code="C2" data-kind="cta">
            <C2 data={standarCta} id="live-c2" />
          </div>
          <div class="composer-item-wrap" data-variant-code="C3" data-kind="cta">
            <C3 data={standarCta} id="live-c3" />
          </div>

          <!-- Footer Variants -->
          <div class="composer-item-wrap" data-variant-code="F1" data-kind="footer">
            <F1 data={standarFooter} id="live-f1" />
          </div>
          <div class="composer-item-wrap" data-variant-code="F2" data-kind="footer">
            <F2 data={standarFooter} id="live-f2" />
          </div>
          <div class="composer-item-wrap" data-variant-code="F3" data-kind="footer">
            <F3 data={standarFooter} id="live-f3" />
          </div>
          <div class="composer-item-wrap" data-variant-code="F4" data-kind="footer">
            <F4 data={standarFooter} id="live-f4" />
          </div>
        </div>
      </div>
    </main>
  </div>

  <script is:inline>
    (function () {
      const STORAGE_KEY = 'layout-lab-composer-recipe';
      const configuredPreviewBaseUrl = document.querySelector('.composer-page')?.getAttribute('data-preview-base-url')?.trim();

      function getPreviewOrigin() {
        if (!configuredPreviewBaseUrl) return window.location.origin;

        try {
          const configuredUrl = new URL(configuredPreviewBaseUrl);
          if (configuredUrl.protocol === 'https:' || configuredUrl.protocol === 'http:') {
            return configuredUrl.origin;
          }
        } catch (e) {}

        return window.location.origin;
      }

      function createPreviewUrl(recipe) {
        const previewUrl = new URL('/pratinjau', getPreviewOrigin());
        if (recipe) previewUrl.searchParams.set('s', recipe);
        return previewUrl.href;
      }

      const SECTION_DEFS = {
        navbar: { name: 'Navbar', variants: ['N1', 'N2', 'N3', 'N4'], default: 'N1' },
        hero: { name: 'Hero', variants: ['H1', 'H2', 'H3', 'H4'], default: 'H1' },
        profil: { name: 'Profil', variants: ['R1', 'R2', 'R3'], default: 'R1' },
        keunggulan: { name: 'Keunggulan', variants: ['K1', 'K2', 'K3'], default: 'K1' },
        layanan: { name: 'Layanan', variants: ['S1', 'S2', 'S3', 'S4'], default: 'S1' },
        langkah: { name: 'Langkah', variants: ['P1', 'P2', 'P3'], default: 'P1' },
        galeri: { name: 'Galeri', variants: ['G1', 'G2', 'G3'], default: 'G1' },
        ulasan: { name: 'Ulasan', variants: ['U1', 'U2', 'U3'], default: 'U1' },
        biaya: { name: 'Biaya', variants: ['B1', 'B2', 'B3'], default: 'B1' },
        'tanya-jawab': { name: 'Tanya Jawab', variants: ['Q1', 'Q2', 'Q3'], default: 'Q1' },
        lokasi: { name: 'Lokasi', variants: ['L1', 'L2', 'L3'], default: 'L1' },
        cta: { name: 'CTA Akhir', variants: ['C1', 'C2', 'C3'], default: 'C1' },
        footer: { name: 'Footer', variants: ['F1', 'F2', 'F3', 'F4'], default: 'F1' }
      };

      const PRESETS = {
        lengkap: ['N1', 'H1', 'R1', 'K1', 'S1', 'P1', 'G1', 'U1', 'B1', 'Q1', 'L1', 'C1', 'F1'],
        jasa: ['N2', 'H1', 'K3', 'S1', 'P2', 'G3', 'U1', 'B2', 'Q2', 'L1', 'C3', 'F1'],
        katalog: ['N1', 'H4', 'S4', 'G2', 'B1', 'U2', 'Q1', 'C1', 'F2'],
        korporat: ['N3', 'H2', 'R3', 'K1', 'S3', 'U3', 'L2', 'C2', 'F1'],
        ringkas: ['N2', 'H1', 'K2', 'S2', 'U1', 'C2', 'F2']
      };

      function variantToKind(variantCode) {
        const prefix = variantCode.charAt(0).toUpperCase();
        switch (prefix) {
          case 'N': return 'navbar';
          case 'H': return 'hero';
          case 'R': return 'profil';
          case 'K': return 'keunggulan';
          case 'S': return 'layanan';
          case 'P': return 'langkah';
          case 'G': return 'galeri';
          case 'U': return 'ulasan';
          case 'B': return 'biaya';
          case 'Q': return 'tanya-jawab';
          case 'L': return 'lokasi';
          case 'C': return 'cta';
          case 'F': return 'footer';
          default: return null;
        }
      }

      // Initial state
      let state = [
        { kind: 'navbar', variant: 'N1', active: true },
        { kind: 'hero', variant: 'H1', active: true },
        { kind: 'profil', variant: 'R1', active: true },
        { kind: 'keunggulan', variant: 'K1', active: true },
        { kind: 'layanan', variant: 'S1', active: true },
        { kind: 'langkah', variant: 'P1', active: true },
        { kind: 'galeri', variant: 'G1', active: true },
        { kind: 'ulasan', variant: 'U1', active: true },
        { kind: 'biaya', variant: 'B1', active: true },
        { kind: 'tanya-jawab', variant: 'Q1', active: true },
        { kind: 'lokasi', variant: 'L1', active: true },
        { kind: 'cta', variant: 'C1', active: true },
        { kind: 'footer', variant: 'F1', active: true }
      ];

      function applyRecipeCodes(codes) {
        const activeKinds = new Set();
        const middleActive = [];
        let navbarItem = null;
        let footerItem = null;

        codes.forEach((code) => {
          const kind = variantToKind(code);
          if (kind && SECTION_DEFS[kind] && SECTION_DEFS[kind].variants.includes(code)) {
            if (kind === 'navbar') {
              if (!navbarItem) {
                navbarItem = { kind: 'navbar', variant: code, active: true };
                activeKinds.add('navbar');
              }
            } else if (kind === 'footer') {
              if (!footerItem) {
                footerItem = { kind: 'footer', variant: code, active: true };
                activeKinds.add('footer');
              }
            } else {
              if (!activeKinds.has(kind)) {
                middleActive.push({ kind, variant: code, active: true });
                activeKinds.add(kind);
              }
            }
          }
        });

        // Ensure navbar is always present at top
        if (!navbarItem) {
          const existing = state.find((item) => item.kind === 'navbar');
          navbarItem = {
            kind: 'navbar',
            variant: existing ? existing.variant : SECTION_DEFS.navbar.default,
            active: false
          };
        }

        // Ensure footer is always present at bottom
        if (!footerItem) {
          const existing = state.find((item) => item.kind === 'footer');
          footerItem = {
            kind: 'footer',
            variant: existing ? existing.variant : SECTION_DEFS.footer.default,
            active: false
          };
        }

        // Add remaining inactive middle kinds in standard order
        const middleInactive = [];
        Object.keys(SECTION_DEFS).forEach((k) => {
          if (k !== 'navbar' && k !== 'footer' && !activeKinds.has(k)) {
            const existing = state.find((item) => item.kind === k);
            middleInactive.push({
              kind: k,
              variant: existing ? existing.variant : SECTION_DEFS[k].default,
              active: false
            });
          }
        });

        state = [navbarItem, ...middleActive, ...middleInactive, footerItem];
      }

      // Check URL parameters first
      const urlParams = new URLSearchParams(window.location.search);
      const urlRecipe = urlParams.get('s');
      const setParam = urlParams.get('set');

      if (urlRecipe && urlRecipe.trim()) {
        const parsed = urlRecipe.split(',').map((s) => s.trim().toUpperCase()).filter(Boolean);
        applyRecipeCodes(parsed);
      } else {
        // Check localStorage
        let saved = null;
        try {
          saved = localStorage.getItem(STORAGE_KEY);
        } catch (e) {}

        if (saved && saved.trim()) {
          const parsed = saved.split(',').map((s) => s.trim().toUpperCase()).filter(Boolean);
          applyRecipeCodes(parsed);
        } else {
          applyRecipeCodes(PRESETS.lengkap);
        }
      }

      // If setParam was passed from /galeri (e.g. ?set=N2)
      if (setParam) {
        const targetKind = variantToKind(setParam);
        if (targetKind && SECTION_DEFS[targetKind] && SECTION_DEFS[targetKind].variants.includes(setParam.toUpperCase())) {
          const found = state.find((item) => item.kind === targetKind);
          if (found) {
            found.variant = setParam.toUpperCase();
            found.active = true;
          }
        }
      }

      // DOM references
      const deckListEl = document.getElementById('composer-deck-list');
      const canvasEl = document.getElementById('composer-canvas');
      const viewportEl = document.getElementById('composer-viewport');
      const recipeDisplayEl = document.getElementById('composer-recipe-display');
      const copyBtn = document.getElementById('btn-copy-preview');
      const openBtn = document.getElementById('btn-open-preview');
      const toggleDeckBtn = document.getElementById('toggle-deck-btn');
      const deckSection = document.getElementById('composer-deck');
      const vpDesktopBtn = document.getElementById('vp-desktop-btn');
      const vpMobileBtn = document.getElementById('vp-mobile-btn');
      const allItemWraps = Array.from(canvasEl.querySelectorAll('.composer-item-wrap'));

      function getRecipeString() {
        return state
          .filter((item) => item.active)
          .map((item) => item.variant)
          .join(',');
      }

      function updateUI() {
        const currentRecipe = getRecipeString();
        if (recipeDisplayEl) {
          recipeDisplayEl.textContent = currentRecipe || '(Tidak ada section aktif)';
        }

        // Update link for client preview
        const clientUrl = createPreviewUrl(currentRecipe);
        if (openBtn) {
          openBtn.href = clientUrl;
        }

        // Save state to URL and localStorage
        if (history.replaceState) {
          const nextUrl = currentRecipe ? `/?s=${currentRecipe}` : '/';
          history.replaceState(null, '', nextUrl);
        }
        try {
          localStorage.setItem(STORAGE_KEY, currentRecipe);
        } catch (e) {}

        // Match preset buttons
        document.querySelectorAll('.composer-preset-btn').forEach((btn) => {
          const pName = btn.getAttribute('data-preset');
          const pRecipe = PRESETS[pName] ? PRESETS[pName].join(',') : '';
          const isMatch = pRecipe === currentRecipe;
          btn.classList.toggle('active', isMatch);
          btn.setAttribute('aria-pressed', String(isMatch));
        });

        // Re-render Deck List
        renderDeck();

        // Re-render Canvas
        renderCanvas();
      }

      function renderDeck() {
        if (!deckListEl) return;
        deckListEl.innerHTML = '';

        state.forEach((item, index) => {
          const def = SECTION_DEFS[item.kind];
          if (!def) return;

          const isNavbar = item.kind === 'navbar';
          const isFooter = item.kind === 'footer';

          const row = document.createElement('div');
          row.className = `composer-deck-row ${item.active ? 'is-active' : 'is-inactive'}`;
          row.setAttribute('data-kind', item.kind);

          // 1. Header row: Checkbox, Section Name, Current Variant Tag, Status, and Order buttons
          const headerRow = document.createElement('div');
          headerRow.className = 'composer-row-header';

          // Left side: checkbox + name + variant indicator + inactive status
          const leftCol = document.createElement('div');
          leftCol.className = 'composer-row-left';

          const checkLabel = document.createElement('label');
          checkLabel.className = 'composer-row-toggle';

          const checkbox = document.createElement('input');
          checkbox.type = 'checkbox';
          checkbox.checked = item.active;
          checkbox.setAttribute('aria-label', `Aktifkan section ${def.name}`);
          checkbox.addEventListener('change', () => {
            item.active = checkbox.checked;
            updateUI();
          });

          const nameSpan = document.createElement('span');
          nameSpan.className = 'composer-row-name';
          nameSpan.textContent = def.name;

          checkLabel.appendChild(checkbox);
          checkLabel.appendChild(nameSpan);
          leftCol.appendChild(checkLabel);

          // Prominent variant tag
          const variantTag = document.createElement('span');
          variantTag.className = 'composer-variant-tag';
          variantTag.textContent = `[${item.variant}]`;
          variantTag.setAttribute('aria-label', `Varian aktif ${item.variant}`);
          variantTag.title = `Varian aktif: ${item.variant}`;
          leftCol.appendChild(variantTag);

          // Inactive indicator
          if (!item.active) {
            const statusSpan = document.createElement('span');
            statusSpan.className = 'composer-row-status';
            statusSpan.textContent = '(Nonaktif)';
            leftCol.appendChild(statusSpan);
          }

          headerRow.appendChild(leftCol);

          // Right side: Order buttons (Side by Side)
          const orderCol = document.createElement('div');
          orderCol.className = 'composer-row-order';
          orderCol.setAttribute('role', 'group');
          orderCol.setAttribute('aria-label', `Urutan section ${def.name}`);

          const upBtn = document.createElement('button');
          upBtn.type = 'button';
          upBtn.className = 'wf-btn composer-mini-btn';
          upBtn.innerHTML = '&#8593;';
          upBtn.setAttribute('aria-label', `Pindahkan ${def.name} ke atas`);
          upBtn.title = isNavbar
            ? 'Navbar selalu berada di posisi paling atas'
            : isFooter
            ? 'Footer selalu berada di posisi paling bawah'
            : !item.active
            ? 'Aktifkan section untuk memindahkan urutan'
            : 'Pindahkan ke atas';
          upBtn.disabled = isNavbar || isFooter || index <= 1 || !item.active;
          upBtn.addEventListener('click', () => {
            if (!upBtn.disabled && index > 1) {
              const temp = state[index];
              state[index] = state[index - 1];
              state[index - 1] = temp;
              updateUI();
            }
          });

          const downBtn = document.createElement('button');
          downBtn.type = 'button';
          downBtn.className = 'wf-btn composer-mini-btn';
          downBtn.innerHTML = '&#8595;';
          downBtn.setAttribute('aria-label', `Pindahkan ${def.name} ke bawah`);
          downBtn.title = isNavbar
            ? 'Navbar selalu berada di posisi paling atas'
            : isFooter
            ? 'Footer selalu berada di posisi paling bawah'
            : !item.active
            ? 'Aktifkan section untuk memindahkan urutan'
            : 'Pindahkan ke bawah';
          downBtn.disabled = isNavbar || isFooter || index >= state.length - 2 || !item.active;
          downBtn.addEventListener('click', () => {
            if (!downBtn.disabled && index < state.length - 2) {
              const temp = state[index];
              state[index] = state[index + 1];
              state[index + 1] = temp;
              updateUI();
            }
          });

          orderCol.appendChild(upBtn);
          orderCol.appendChild(downBtn);
          headerRow.appendChild(orderCol);

          row.appendChild(headerRow);

          // 2. Bottom row: Segmented variant buttons
          const variantWrap = document.createElement('div');
          variantWrap.className = 'composer-row-variants';
          variantWrap.setAttribute('role', 'group');
          variantWrap.setAttribute('aria-label', `Pilihan varian ${def.name}`);

          def.variants.forEach((v) => {
            const isSelected = item.variant === v;
            const vBtn = document.createElement('button');
            vBtn.type = 'button';
            vBtn.className = `wf-btn composer-v-choice ${isSelected ? 'active' : ''}`;
            vBtn.textContent = v;
            vBtn.setAttribute('aria-pressed', isSelected ? 'true' : 'false');
            vBtn.setAttribute('aria-label', `Pilih varian ${v}`);
            vBtn.title = `Pilih varian ${v}${!item.active ? ' (aktifkan section)' : ''}`;
            vBtn.addEventListener('click', () => {
              item.variant = v;
              item.active = true;
              updateUI();
            });
            variantWrap.appendChild(vBtn);
          });

          row.appendChild(variantWrap);

          deckListEl.appendChild(row);
        });
      }

      function renderCanvas() {
        if (!canvasEl) return;

        // Hide all wraps first
        allItemWraps.forEach((wrap) => {
          wrap.style.display = 'none';
          wrap.removeAttribute('id');
        });

        // Append active wraps in order
        state.forEach((item) => {
          if (item.active) {
            const target = allItemWraps.find((w) => w.getAttribute('data-variant-code') === item.variant);
            if (target) {
              target.id = 'section-' + item.kind;
              target.style.display = 'block';
              canvasEl.appendChild(target);
            }
          }
        });
      }

      // Presets click listeners
      document.querySelectorAll('.composer-preset-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const pName = btn.getAttribute('data-preset');
          if (PRESETS[pName]) {
            applyRecipeCodes(PRESETS[pName]);
            updateUI();
          }
        });
      });

      // Viewport toggle
      if (vpDesktopBtn && vpMobileBtn && viewportEl) {
        vpDesktopBtn.addEventListener('click', () => {
          vpDesktopBtn.classList.add('active');
          vpDesktopBtn.setAttribute('aria-pressed', 'true');
          vpMobileBtn.classList.remove('active');
          vpMobileBtn.setAttribute('aria-pressed', 'false');
          viewportEl.classList.remove('is-mobile-view');
        });

        vpMobileBtn.addEventListener('click', () => {
          vpMobileBtn.classList.add('active');
          vpMobileBtn.setAttribute('aria-pressed', 'true');
          vpDesktopBtn.classList.remove('active');
          vpDesktopBtn.setAttribute('aria-pressed', 'false');
          viewportEl.classList.add('is-mobile-view');
        });
      }

      // Toggle Deck
      if (toggleDeckBtn && deckSection) {
        toggleDeckBtn.addEventListener('click', () => {
          const isClosed = deckSection.classList.toggle('is-collapsed');
          toggleDeckBtn.setAttribute('aria-expanded', String(!isClosed));
          toggleDeckBtn.textContent = isClosed ? 'Buka Panel Kontrol' : 'Sembunyikan Panel Kontrol';
        });
      }

      // Copy Client Link Button
      if (copyBtn) {
        copyBtn.addEventListener('click', () => {
          const currentRecipe = getRecipeString();
          const clientUrl = createPreviewUrl(currentRecipe);
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(clientUrl).then(() => {
              const orig = copyBtn.textContent;
              copyBtn.textContent = 'Link Tersalin!';
              setTimeout(() => {
                copyBtn.textContent = orig;
              }, 2000);
            }).catch(() => {
              prompt('Salin link klien berikut:', clientUrl);
            });
          } else {
            prompt('Salin link klien berikut:', clientUrl);
          }
        });
      }

      // Smooth scroll inside canvas
      canvasEl.addEventListener('click', (e) => {
        const anchor = e.target.closest('a');
        if (!anchor) return;
        const href = anchor.getAttribute('href');
        if (!href) return;

        if (href.startsWith('#')) {
          e.preventDefault();
          if (href === '#' || href === '') return;
          const targetEl = canvasEl.querySelector(href);
          if (targetEl) {
            targetEl.scrollIntoView({ behavior: 'smooth' });
          }
        }
      });

      // Initialize
      updateUI();
    })();
  </script>

