---
import BaseLayout from '../layouts/BaseLayout.astro';
import N1 from '../sections/navbar/N1.astro';
import N2 from '../sections/navbar/N2.astro';
import N3 from '../sections/navbar/N3.astro';
import N4 from '../sections/navbar/N4.astro';
import H1 from '../sections/hero/H1.astro';
import H2 from '../sections/hero/H2.astro';
import H3 from '../sections/hero/H3.astro';
import H4 from '../sections/hero/H4.astro';
import S1 from '../sections/layanan/S1.astro';
import S2 from '../sections/layanan/S2.astro';
import S3 from '../sections/layanan/S3.astro';
import S4 from '../sections/layanan/S4.astro';
import F1 from '../sections/footer/F1.astro';
import F2 from '../sections/footer/F2.astro';
import F3 from '../sections/footer/F3.astro';
import F4 from '../sections/footer/F4.astro';
import P1 from '../sections/langkah/P1.astro';
import P2 from '../sections/langkah/P2.astro';
import P3 from '../sections/langkah/P3.astro';
import K1 from '../sections/keunggulan/K1.astro';
import K2 from '../sections/keunggulan/K2.astro';
import K3 from '../sections/keunggulan/K3.astro';
import L1 from '../sections/lokasi/L1.astro';
import L2 from '../sections/lokasi/L2.astro';
import L3 from '../sections/lokasi/L3.astro';
import C1 from '../sections/cta/C1.astro';
import C2 from '../sections/cta/C2.astro';
import C3 from '../sections/cta/C3.astro';
import G1 from '../sections/galeri/G1.astro';
import G2 from '../sections/galeri/G2.astro';
import G3 from '../sections/galeri/G3.astro';
import U1 from '../sections/ulasan/U1.astro';
import U2 from '../sections/ulasan/U2.astro';
import U3 from '../sections/ulasan/U3.astro';
import B1 from '../sections/biaya/B1.astro';
import B2 from '../sections/biaya/B2.astro';
import B3 from '../sections/biaya/B3.astro';
import Q1 from '../sections/tanya-jawab/Q1.astro';
import Q2 from '../sections/tanya-jawab/Q2.astro';
import Q3 from '../sections/tanya-jawab/Q3.astro';
import R1 from '../sections/profil/R1.astro';
import R2 from '../sections/profil/R2.astro';
import R3 from '../sections/profil/R3.astro';

import { pendekNavbar, panjangNavbar, tanpaGambarNavbar, kosongNavbar } from '../schema/navbar';
import { pendekHero, panjangHero, tanpaGambarHero, kosongHero } from '../schema/hero';
import { pendekLayanan, panjangLayanan, tanpaGambarLayanan, kosongLayanan, loadingLayanan, errorLayanan } from '../schema/layanan';
import { pendekFooter, panjangFooter, tanpaGambarFooter, kosongFooter } from '../schema/footer';
import { pendekLangkah, panjangLangkah, tanpaIntroLangkah, kosongLangkah, loadingLangkah, errorLangkah } from '../schema/langkah';
import { pendekKeunggulan, panjangKeunggulan, tanpaIntroKeunggulan, kosongKeunggulan, loadingKeunggulan, errorKeunggulan } from '../schema/keunggulan';
import { pendekLokasi, panjangLokasi, tanpaLandmarkLokasi, kosongLokasi, loadingLokasi, errorLokasi } from '../schema/lokasi';
import { pendekCta, panjangCta, tanpaKontakCta, tanpaTeksCta, kosongCta, loadingCta, errorCta } from '../schema/cta';
import { pendekGaleri, panjangGaleri, tanpaOpsionalGaleri, kosongGaleri, loadingGaleri, errorGaleri } from '../schema/galeri';
import { pendekUlasan, panjangUlasan, tanpaOpsionalUlasan, kosongUlasan, loadingUlasan, errorUlasan } from '../schema/ulasan';
import { pendekBiaya, panjangBiaya, tanpaOpsionalBiaya, kosongBiaya, loadingBiaya, errorBiaya } from '../schema/biaya';
import { pendekTanyaJawab, panjangTanyaJawab, tanpaOpsionalTanyaJawab, kosongTanyaJawab, loadingTanyaJawab, errorTanyaJawab } from '../schema/tanya-jawab';
import { pendekProfil, panjangProfil, tanpaOpsionalProfil, kosongProfil, loadingProfil, errorProfil } from '../schema/profil';
---

<BaseLayout title="Laboratorium Uji Ketahanan Data">
  <div class="uji-page">
    <header class="wf-container uji-header">
      <div class="uji-intro">
        <h1 class="uji-title">Pengujian Resiliensi Data Ekstrem</h1>
        <p class="uji-desc">
          Evaluasi perilaku setiap varian terhadap teks sangat pendek, teks sangat panjang, ketiadaan elemen gambar, serta penanganan status antarmuka kosong, memuat, dan galat.
        </p>
      </div>

      <div class="uji-controls">
        <div class="uji-controls-label">Pilih Dataset Pengujian:</div>
        <div class="uji-button-group">
          <button type="button" class="wf-btn uji-btn active" data-mode="pendek">
            [1] Data Pendek
          </button>
          <button type="button" class="wf-btn uji-btn" data-mode="panjang">
            [2] Data Panjang
          </button>
          <button type="button" class="wf-btn uji-btn" data-mode="tanpa-gambar">
            [3] Tanpa Gambar / Field Opsional
          </button>
          <button type="button" class="wf-btn uji-btn" data-mode="status">
            [4] Status Antarmuka
          </button>
        </div>
      </div>
    </header>

    <main class="uji-suite active" data-suite="pendek" id="suite-pendek">
      <div class="wf-container uji-suite-banner">
        <h2>Skenario 1: Data Sangat Pendek (Uji Kekosongan & Kerapatan)</h2>
        <p>Memastikan elemen antarmuka tidak kolaps, teks pendek tetap terbaca jelas, dan tombol aksi tetap memiliki ruang klik minimal 44px.</p>
      </div>

      <div class="uji-variant-block"><div class="uji-tag">N1 (Pendek)</div><N1 data={pendekNavbar} id="u-n1-p" /></div>
      <div class="uji-variant-block"><div class="uji-tag">N2 (Pendek)</div><N2 data={pendekNavbar} id="u-n2-p" /></div>
      <div class="uji-variant-block"><div class="uji-tag">N3 (Pendek)</div><N3 data={pendekNavbar} id="u-n3-p" /></div>
      <div class="uji-variant-block"><div class="uji-tag">N4 (Pendek)</div><N4 data={pendekNavbar} id="u-n4-p" /></div>

      <div class="uji-variant-block"><div class="uji-tag">H1 (Pendek)</div><H1 data={pendekHero} id="u-h1-p" /></div>
      <div class="uji-variant-block"><div class="uji-tag">H2 (Pendek)</div><H2 data={pendekHero} id="u-h2-p" /></div>
      <div class="uji-variant-block"><div class="uji-tag">H3 (Pendek)</div><H3 data={pendekHero} id="u-h3-p" /></div>
      <div class="uji-variant-block"><div class="uji-tag">H4 (Pendek)</div><H4 data={pendekHero} id="u-h4-p" /></div>

      <div class="uji-variant-block"><div class="uji-tag">S1 (Pendek)</div><S1 data={pendekLayanan} id="u-s1-p" /></div>
      <div class="uji-variant-block"><div class="uji-tag">S2 (Pendek)</div><S2 data={pendekLayanan} id="u-s2-p" /></div>
      <div class="uji-variant-block"><div class="uji-tag">S3 (Pendek)</div><S3 data={pendekLayanan} id="u-s3-p" /></div>
      <div class="uji-variant-block"><div class="uji-tag">S4 (Pendek)</div><S4 data={pendekLayanan} id="u-s4-p" /></div>

      <div class="uji-variant-block"><div class="uji-tag">F1 (Pendek)</div><F1 data={pendekFooter} id="u-f1-p" /></div>
      <div class="uji-variant-block"><div class="uji-tag">F2 (Pendek)</div><F2 data={pendekFooter} id="u-f2-p" /></div>
      <div class="uji-variant-block"><div class="uji-tag">F3 (Pendek)</div><F3 data={pendekFooter} id="u-f3-p" /></div>
      <div class="uji-variant-block"><div class="uji-tag">F4 (Pendek)</div><F4 data={pendekFooter} id="u-f4-p" /></div>

      <div class="uji-variant-block"><div class="uji-tag">P1 (Pendek)</div><P1 data={pendekLangkah} id="u-p1-p" /></div>
      <div class="uji-variant-block"><div class="uji-tag">P2 (Pendek)</div><P2 data={pendekLangkah} id="u-p2-p" /></div>
      <div class="uji-variant-block"><div class="uji-tag">P3 (Pendek)</div><P3 data={pendekLangkah} id="u-p3-p" /></div>

      <div class="uji-variant-block"><div class="uji-tag">K1 (Pendek)</div><K1 data={pendekKeunggulan} id="u-k1-p" /></div>
      <div class="uji-variant-block"><div class="uji-tag">K2 (Pendek)</div><K2 data={pendekKeunggulan} id="u-k2-p" /></div>
      <div class="uji-variant-block"><div class="uji-tag">K3 (Pendek)</div><K3 data={pendekKeunggulan} id="u-k3-p" /></div>

      <div class="uji-variant-block"><div class="uji-tag">L1 (Pendek)</div><L1 data={pendekLokasi} id="u-l1-p" /></div>
      <div class="uji-variant-block"><div class="uji-tag">L2 (Pendek)</div><L2 data={pendekLokasi} id="u-l2-p" /></div>
      <div class="uji-variant-block"><div class="uji-tag">L3 (Pendek)</div><L3 data={pendekLokasi} id="u-l3-p" /></div>

      <div class="uji-variant-block"><div class="uji-tag">C1 (Pendek)</div><C1 data={pendekCta} id="u-c1-p" /></div>
      <div class="uji-variant-block"><div class="uji-tag">C2 (Pendek)</div><C2 data={pendekCta} id="u-c2-p" /></div>
      <div class="uji-variant-block"><div class="uji-tag">C3 (Pendek)</div><C3 data={pendekCta} id="u-c3-p" /></div>

      <div class="uji-variant-block"><div class="uji-tag">G1 (Pendek)</div><G1 data={pendekGaleri} id="u-g1-p" /></div>
      <div class="uji-variant-block"><div class="uji-tag">G2 (Pendek)</div><G2 data={pendekGaleri} id="u-g2-p" /></div>
      <div class="uji-variant-block"><div class="uji-tag">G3 (Pendek)</div><G3 data={pendekGaleri} id="u-g3-p" /></div>

      <div class="uji-variant-block"><div class="uji-tag">U1 (Pendek)</div><U1 data={pendekUlasan} id="u-u1-p" /></div>
      <div class="uji-variant-block"><div class="uji-tag">U2 (Pendek)</div><U2 data={pendekUlasan} id="u-u2-p" /></div>
      <div class="uji-variant-block"><div class="uji-tag">U3 (Pendek)</div><U3 data={pendekUlasan} id="u-u3-p" /></div>

      <div class="uji-variant-block"><div class="uji-tag">B1 (Pendek)</div><B1 data={pendekBiaya} id="u-b1-p" /></div>
      <div class="uji-variant-block"><div class="uji-tag">B2 (Pendek)</div><B2 data={pendekBiaya} id="u-b2-p" /></div>
      <div class="uji-variant-block"><div class="uji-tag">B3 (Pendek)</div><B3 data={pendekBiaya} id="u-b3-p" /></div>

      <div class="uji-variant-block"><div class="uji-tag">Q1 (Pendek)</div><Q1 data={pendekTanyaJawab} id="u-q1-p" /></div>
      <div class="uji-variant-block"><div class="uji-tag">Q2 (Pendek)</div><Q2 data={pendekTanyaJawab} id="u-q2-p" /></div>
      <div class="uji-variant-block"><div class="uji-tag">Q3 (Pendek)</div><Q3 data={pendekTanyaJawab} id="u-q3-p" /></div>

      <div class="uji-variant-block"><div class="uji-tag">R1 (Pendek)</div><R1 data={pendekProfil} id="u-r1-p" /></div>
      <div class="uji-variant-block"><div class="uji-tag">R2 (Pendek)</div><R2 data={pendekProfil} id="u-r2-p" /></div>
      <div class="uji-variant-block"><div class="uji-tag">R3 (Pendek)</div><R3 data={pendekProfil} id="u-r3-p" /></div>
    </main>

    <main class="uji-suite" data-suite="panjang" id="suite-panjang">
      <div class="wf-container uji-suite-banner">
        <h2>Skenario 2: Data Sangat Panjang (Uji Pembungkusan Teks & Beban Kontainer)</h2>
        <p>Memverifikasi bahwa teks yang sangat panjang terbungkus rapi tanpa kebocoran horizontal (nol overflow) dan perataan grid tetap seimbang.</p>
      </div>

      <div class="uji-variant-block"><div class="uji-tag">N1 (Panjang)</div><N1 data={panjangNavbar} id="u-n1-l" /></div>
      <div class="uji-variant-block"><div class="uji-tag">N2 (Panjang)</div><N2 data={panjangNavbar} id="u-n2-l" /></div>
      <div class="uji-variant-block"><div class="uji-tag">N3 (Panjang)</div><N3 data={panjangNavbar} id="u-n3-l" /></div>
      <div class="uji-variant-block"><div class="uji-tag">N4 (Panjang)</div><N4 data={panjangNavbar} id="u-n4-l" /></div>

      <div class="uji-variant-block"><div class="uji-tag">H1 (Panjang)</div><H1 data={panjangHero} id="u-h1-l" /></div>
      <div class="uji-variant-block"><div class="uji-tag">H2 (Panjang)</div><H2 data={panjangHero} id="u-h2-l" /></div>
      <div class="uji-variant-block"><div class="uji-tag">H3 (Panjang)</div><H3 data={panjangHero} id="u-h3-l" /></div>
      <div class="uji-variant-block"><div class="uji-tag">H4 (Panjang)</div><H4 data={panjangHero} id="u-h4-l" /></div>

      <div class="uji-variant-block"><div class="uji-tag">S1 (Panjang)</div><S1 data={panjangLayanan} id="u-s1-l" /></div>
      <div class="uji-variant-block"><div class="uji-tag">S2 (Panjang)</div><S2 data={panjangLayanan} id="u-s2-l" /></div>
      <div class="uji-variant-block"><div class="uji-tag">S3 (Panjang)</div><S3 data={panjangLayanan} id="u-s3-l" /></div>
      <div class="uji-variant-block"><div class="uji-tag">S4 (Panjang)</div><S4 data={panjangLayanan} id="u-s4-l" /></div>

      <div class="uji-variant-block"><div class="uji-tag">F1 (Panjang)</div><F1 data={panjangFooter} id="u-f1-l" /></div>
      <div class="uji-variant-block"><div class="uji-tag">F2 (Panjang)</div><F2 data={panjangFooter} id="u-f2-l" /></div>
      <div class="uji-variant-block"><div class="uji-tag">F3 (Panjang)</div><F3 data={panjangFooter} id="u-f3-l" /></div>
      <div class="uji-variant-block"><div class="uji-tag">F4 (Panjang)</div><F4 data={panjangFooter} id="u-f4-l" /></div>

      <div class="uji-variant-block"><div class="uji-tag">P1 (Panjang)</div><P1 data={panjangLangkah} id="u-p1-l" /></div>
      <div class="uji-variant-block"><div class="uji-tag">P2 (Panjang)</div><P2 data={panjangLangkah} id="u-p2-l" /></div>
      <div class="uji-variant-block"><div class="uji-tag">P3 (Panjang)</div><P3 data={panjangLangkah} id="u-p3-l" /></div>

      <div class="uji-variant-block"><div class="uji-tag">K1 (Panjang)</div><K1 data={panjangKeunggulan} id="u-k1-l" /></div>
      <div class="uji-variant-block"><div class="uji-tag">K2 (Panjang)</div><K2 data={panjangKeunggulan} id="u-k2-l" /></div>
      <div class="uji-variant-block"><div class="uji-tag">K3 (Panjang)</div><K3 data={panjangKeunggulan} id="u-k3-l" /></div>

      <div class="uji-variant-block"><div class="uji-tag">L1 (Panjang)</div><L1 data={panjangLokasi} id="u-l1-l" /></div>
      <div class="uji-variant-block"><div class="uji-tag">L2 (Panjang)</div><L2 data={panjangLokasi} id="u-l2-l" /></div>
      <div class="uji-variant-block"><div class="uji-tag">L3 (Panjang)</div><L3 data={panjangLokasi} id="u-l3-l" /></div>

      <div class="uji-variant-block"><div class="uji-tag">C1 (Panjang)</div><C1 data={panjangCta} id="u-c1-l" /></div>
      <div class="uji-variant-block"><div class="uji-tag">C2 (Panjang)</div><C2 data={panjangCta} id="u-c2-l" /></div>
      <div class="uji-variant-block"><div class="uji-tag">C3 (Panjang)</div><C3 data={panjangCta} id="u-c3-l" /></div>

      <div class="uji-variant-block"><div class="uji-tag">G1 (Panjang)</div><G1 data={panjangGaleri} id="u-g1-l" /></div>
      <div class="uji-variant-block"><div class="uji-tag">G2 (Panjang)</div><G2 data={panjangGaleri} id="u-g2-l" /></div>
      <div class="uji-variant-block"><div class="uji-tag">G3 (Panjang)</div><G3 data={panjangGaleri} id="u-g3-l" /></div>

      <div class="uji-variant-block"><div class="uji-tag">U1 (Panjang)</div><U1 data={panjangUlasan} id="u-u1-l" /></div>
      <div class="uji-variant-block"><div class="uji-tag">U2 (Panjang)</div><U2 data={panjangUlasan} id="u-u2-l" /></div>
      <div class="uji-variant-block"><div class="uji-tag">U3 (Panjang)</div><U3 data={panjangUlasan} id="u-u3-l" /></div>

      <div class="uji-variant-block"><div class="uji-tag">B1 (Panjang)</div><B1 data={panjangBiaya} id="u-b1-l" /></div>
      <div class="uji-variant-block"><div class="uji-tag">B2 (Panjang)</div><B2 data={panjangBiaya} id="u-b2-l" /></div>
      <div class="uji-variant-block"><div class="uji-tag">B3 (Panjang)</div><B3 data={panjangBiaya} id="u-b3-l" /></div>

      <div class="uji-variant-block"><div class="uji-tag">Q1 (Panjang)</div><Q1 data={panjangTanyaJawab} id="u-q1-l" /></div>
      <div class="uji-variant-block"><div class="uji-tag">Q2 (Panjang)</div><Q2 data={panjangTanyaJawab} id="u-q2-l" /></div>
      <div class="uji-variant-block"><div class="uji-tag">Q3 (Panjang)</div><Q3 data={panjangTanyaJawab} id="u-q3-l" /></div>

      <div class="uji-variant-block"><div class="uji-tag">R1 (Panjang)</div><R1 data={panjangProfil} id="u-r1-l" /></div>
      <div class="uji-variant-block"><div class="uji-tag">R2 (Panjang)</div><R2 data={panjangProfil} id="u-r2-l" /></div>
      <div class="uji-variant-block"><div class="uji-tag">R3 (Panjang)</div><R3 data={panjangProfil} id="u-r3-l" /></div>
    </main>

    <main class="uji-suite" data-suite="tanpa-gambar" id="suite-tanpa-gambar">
      <div class="wf-container uji-suite-banner">
        <h2>Skenario 3: Tanpa Gambar (Uji Fallback Visual Bersih)</h2>
        <p>Memverifikasi bahwa ketiadaan gambar (visual: undefined) tidak meninggalkan kotak kosong rusak atau ruang pincang, melainkan mengaktifkan tata letak cadangan struktural yang utuh.</p>
      </div>

      <div class="uji-variant-block"><div class="uji-tag">N1 (Tanpa Gambar)</div><N1 data={tanpaGambarNavbar} id="u-n1-ng" /></div>
      <div class="uji-variant-block"><div class="uji-tag">N2 (Tanpa Gambar)</div><N2 data={tanpaGambarNavbar} id="u-n2-ng" /></div>
      <div class="uji-variant-block"><div class="uji-tag">N3 (Tanpa Gambar)</div><N3 data={tanpaGambarNavbar} id="u-n3-ng" /></div>
      <div class="uji-variant-block"><div class="uji-tag">N4 (Tanpa Gambar)</div><N4 data={tanpaGambarNavbar} id="u-n4-ng" /></div>

      <div class="uji-variant-block"><div class="uji-tag">H1 (Tanpa Gambar: Fallback Modul Teks Penuh)</div><H1 data={tanpaGambarHero} id="u-h1-ng" /></div>
      <div class="uji-variant-block"><div class="uji-tag">H2 (Tanpa Gambar: Terpusat Murni)</div><H2 data={tanpaGambarHero} id="u-h2-ng" /></div>
      <div class="uji-variant-block"><div class="uji-tag">H3 (Tanpa Gambar: Kanvas Arsitektural)</div><H3 data={tanpaGambarHero} id="u-h3-ng" /></div>
      <div class="uji-variant-block"><div class="uji-tag">H4 (Tanpa Gambar: Spesifikasi Kartu)</div><H4 data={tanpaGambarHero} id="u-h4-ng" /></div>

      <div class="uji-variant-block"><div class="uji-tag">S1 (Tanpa Gambar: Kartu Spesifikasi Teks)</div><S1 data={tanpaGambarLayanan} id="u-s1-ng" /></div>
      <div class="uji-variant-block"><div class="uji-tag">S2 (Tanpa Gambar: Baris Horisontal)</div><S2 data={tanpaGambarLayanan} id="u-s2-ng" /></div>
      <div class="uji-variant-block"><div class="uji-tag">S3 (Tanpa Gambar: Kolom Tetap dan Daftar)</div><S3 data={tanpaGambarLayanan} id="u-s3-ng" /></div>
      <div class="uji-variant-block"><div class="uji-tag">S4 (Tanpa Gambar: Penanda Indeks Struktural [01][02])</div><S4 data={tanpaGambarLayanan} id="u-s4-ng" /></div>

      <div class="uji-variant-block"><div class="uji-tag">F1 (Tanpa Gambar)</div><F1 data={tanpaGambarFooter} id="u-f1-ng" /></div>
      <div class="uji-variant-block"><div class="uji-tag">F2 (Tanpa Gambar)</div><F2 data={tanpaGambarFooter} id="u-f2-ng" /></div>
      <div class="uji-variant-block"><div class="uji-tag">F3 (Tanpa Gambar)</div><F3 data={tanpaGambarFooter} id="u-f3-ng" /></div>
      <div class="uji-variant-block"><div class="uji-tag">F4 (Tanpa Gambar)</div><F4 data={tanpaGambarFooter} id="u-f4-ng" /></div>

      <div class="uji-variant-block"><div class="uji-tag">P1 (Tanpa Intro)</div><P1 data={tanpaIntroLangkah} id="u-p1-opt" /></div>
      <div class="uji-variant-block"><div class="uji-tag">P2 (Tanpa Intro)</div><P2 data={tanpaIntroLangkah} id="u-p2-opt" /></div>
      <div class="uji-variant-block"><div class="uji-tag">P3 (Tanpa Intro)</div><P3 data={tanpaIntroLangkah} id="u-p3-opt" /></div>

      <div class="uji-variant-block"><div class="uji-tag">K1 (Tanpa Intro)</div><K1 data={tanpaIntroKeunggulan} id="u-k1-opt" /></div>
      <div class="uji-variant-block"><div class="uji-tag">K2 (Tanpa Intro)</div><K2 data={tanpaIntroKeunggulan} id="u-k2-opt" /></div>
      <div class="uji-variant-block"><div class="uji-tag">K3 (Tanpa Intro)</div><K3 data={tanpaIntroKeunggulan} id="u-k3-opt" /></div>

      <div class="uji-variant-block"><div class="uji-tag">L1 (Tanpa Landmark)</div><L1 data={tanpaLandmarkLokasi} id="u-l1-opt" /></div>
