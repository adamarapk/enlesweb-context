  <script is:inline>
    function setSuiteMode(mode) {
      document.querySelectorAll('.uji-btn').forEach((btn) => {
        const isActive = btn.getAttribute('data-mode') === mode;
        btn.classList.toggle('active', isActive);
        btn.setAttribute('aria-pressed', String(isActive));
      });

      document.querySelectorAll('.uji-suite').forEach((suite) => {
        suite.classList.toggle('active', suite.getAttribute('data-suite') === mode);
      });
    }

    document.querySelectorAll('.uji-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const mode = btn.getAttribute('data-mode');
        if (mode) setSuiteMode(mode);
      });
    });

    // Initialize initial ARIA states
    document.querySelectorAll('.uji-btn').forEach((btn) => {
      btn.setAttribute('aria-pressed', String(btn.classList.contains('active')));
    });

    const urlMode = new URLSearchParams(window.location.search).get('mode');
    if (urlMode && ['pendek', 'panjang', 'tanpa-gambar', 'status'].includes(urlMode)) {
      setSuiteMode(urlMode);
    }
  </script>

