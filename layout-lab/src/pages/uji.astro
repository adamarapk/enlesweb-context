      color: var(--wf-ink);
      line-height: 1.6;
      max-width: 48rem;
    }

    .uji-controls {
      background-color: var(--wf-fill);
      border: 1px solid var(--wf-line);
      border-radius: var(--wf-radius);
      padding: var(--wf-space-3);
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--wf-space-3);
    }

    .uji-controls-label {
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 0.8125rem;
      font-weight: 700;
      color: var(--wf-ink);
    }

    .uji-button-group {
      display: flex;
      flex-wrap: wrap;
      gap: var(--wf-space-2);
    }

    .uji-btn {
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 0.8125rem;
      font-weight: 700;
      padding: var(--wf-space-2) var(--wf-space-3);
      background-color: var(--wf-bg);
      border: 1px solid var(--wf-line);
