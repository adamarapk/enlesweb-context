      <div class="uji-variant-block"><div class="uji-tag">P3 (Status Galat: Gagal Memuat Alur)</div><P3 data={errorLangkah} id="u-p3-e" /></div>

      <div class="uji-variant-block"><div class="uji-tag">K1 (Status Kosong: Karakteristik Kosong)</div><K1 data={kosongKeunggulan} id="u-k1-k" /></div>
      <div class="uji-variant-block"><div class="uji-tag">K2 (Status Memuat: Memuat Karakteristik)</div><K2 data={loadingKeunggulan} id="u-k2-load" /></div>
      <div class="uji-variant-block"><div class="uji-tag">K3 (Status Galat: Gagal Memuat Karakteristik)</div><K3 data={errorKeunggulan} id="u-k3-e" /></div>

