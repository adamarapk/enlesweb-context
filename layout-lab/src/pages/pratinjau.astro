---
import BaseLayout from '../layouts/BaseLayout.astro';

// Navbar
import N1 from '../sections/navbar/N1.astro';
import N2 from '../sections/navbar/N2.astro';
import N3 from '../sections/navbar/N3.astro';
import N4 from '../sections/navbar/N4.astro';

// Hero
import H1 from '../sections/hero/H1.astro';
import H2 from '../sections/hero/H2.astro';
import H3 from '../sections/hero/H3.astro';
import H4 from '../sections/hero/H4.astro';

// Keunggulan
import K1 from '../sections/keunggulan/K1.astro';
import K2 from '../sections/keunggulan/K2.astro';
import K3 from '../sections/keunggulan/K3.astro';

// Layanan
import S1 from '../sections/layanan/S1.astro';
import S2 from '../sections/layanan/S2.astro';
import S3 from '../sections/layanan/S3.astro';
import S4 from '../sections/layanan/S4.astro';

// Langkah
import P1 from '../sections/langkah/P1.astro';
import P2 from '../sections/langkah/P2.astro';
import P3 from '../sections/langkah/P3.astro';

// Galeri
import G1 from '../sections/galeri/G1.astro';
import G2 from '../sections/galeri/G2.astro';
import G3 from '../sections/galeri/G3.astro';

// Ulasan
import U1 from '../sections/ulasan/U1.astro';
import U2 from '../sections/ulasan/U2.astro';
import U3 from '../sections/ulasan/U3.astro';

// Biaya
import B1 from '../sections/biaya/B1.astro';
import B2 from '../sections/biaya/B2.astro';
import B3 from '../sections/biaya/B3.astro';

// Tanya Jawab
import Q1 from '../sections/tanya-jawab/Q1.astro';
import Q2 from '../sections/tanya-jawab/Q2.astro';
import Q3 from '../sections/tanya-jawab/Q3.astro';

// Profil
import R1 from '../sections/profil/R1.astro';
import R2 from '../sections/profil/R2.astro';
import R3 from '../sections/profil/R3.astro';

// Lokasi
import L1 from '../sections/lokasi/L1.astro';
import L2 from '../sections/lokasi/L2.astro';
import L3 from '../sections/lokasi/L3.astro';

// CTA Akhir
import C1 from '../sections/cta/C1.astro';
import C2 from '../sections/cta/C2.astro';
import C3 from '../sections/cta/C3.astro';

// Footer
import F1 from '../sections/footer/F1.astro';
import F2 from '../sections/footer/F2.astro';
import F3 from '../sections/footer/F3.astro';
import F4 from '../sections/footer/F4.astro';

// Standar Datasets
import { standarNavbar } from '../schema/navbar';
import { standarHero } from '../schema/hero';
import { standarKeunggulan } from '../schema/keunggulan';
import { standarLayanan } from '../schema/layanan';
import { standarLangkah } from '../schema/langkah';
import { standarGaleri } from '../schema/galeri';
import { standarUlasan } from '../schema/ulasan';
import { standarBiaya } from '../schema/biaya';
import { standarTanyaJawab } from '../schema/tanya-jawab';
import { standarProfil } from '../schema/profil';
import { standarLokasi } from '../schema/lokasi';
import { standarCta } from '../schema/cta';
import { standarFooter } from '../schema/footer';
---

<BaseLayout title="Pratinjau Struktur Website" clean={true}>
  <div class="pratinjau-page" id="pratinjau-root">
    <!-- Navbar Variants -->
    <div class="pratinjau-variant-wrap" data-variant-code="N1" data-kind="navbar">
      <N1 data={standarNavbar} id="preview-n1" />
    </div>
    <div class="pratinjau-variant-wrap" data-variant-code="N2" data-kind="navbar">
      <N2 data={standarNavbar} id="preview-n2" />
    </div>
    <div class="pratinjau-variant-wrap" data-variant-code="N3" data-kind="navbar">
      <N3 data={standarNavbar} id="preview-n3" />
    </div>
    <div class="pratinjau-variant-wrap" data-variant-code="N4" data-kind="navbar">
      <N4 data={standarNavbar} id="preview-n4" />
    </div>

    <!-- Hero Variants -->
    <div class="pratinjau-variant-wrap" data-variant-code="H1" data-kind="hero">
      <H1 data={standarHero} id="preview-h1" />
    </div>
    <div class="pratinjau-variant-wrap" data-variant-code="H2" data-kind="hero">
      <H2 data={standarHero} id="preview-h2" />
    </div>
    <div class="pratinjau-variant-wrap" data-variant-code="H3" data-kind="hero">
      <H3 data={standarHero} id="preview-h3" />
    </div>
    <div class="pratinjau-variant-wrap" data-variant-code="H4" data-kind="hero">
      <H4 data={standarHero} id="preview-h4" />
    </div>

    <!-- Profil Variants -->
    <div class="pratinjau-variant-wrap" data-variant-code="R1" data-kind="profil">
      <R1 data={standarProfil} id="preview-r1" />
    </div>
    <div class="pratinjau-variant-wrap" data-variant-code="R2" data-kind="profil">
      <R2 data={standarProfil} id="preview-r2" />
    </div>
    <div class="pratinjau-variant-wrap" data-variant-code="R3" data-kind="profil">
      <R3 data={standarProfil} id="preview-r3" />
    </div>

    <!-- Keunggulan Variants -->
    <div class="pratinjau-variant-wrap" data-variant-code="K1" data-kind="keunggulan">
      <K1 data={standarKeunggulan} id="preview-k1" />
    </div>
    <div class="pratinjau-variant-wrap" data-variant-code="K2" data-kind="keunggulan">
      <K2 data={standarKeunggulan} id="preview-k2" />
    </div>
    <div class="pratinjau-variant-wrap" data-variant-code="K3" data-kind="keunggulan">
      <K3 data={standarKeunggulan} id="preview-k3" />
    </div>

    <!-- Layanan Variants -->
    <div class="pratinjau-variant-wrap" data-variant-code="S1" data-kind="layanan">
      <S1 data={standarLayanan} id="preview-s1" />
    </div>
    <div class="pratinjau-variant-wrap" data-variant-code="S2" data-kind="layanan">
      <S2 data={standarLayanan} id="preview-s2" />
    </div>
    <div class="pratinjau-variant-wrap" data-variant-code="S3" data-kind="layanan">
      <S3 data={standarLayanan} id="preview-s3" />
    </div>
    <div class="pratinjau-variant-wrap" data-variant-code="S4" data-kind="layanan">
      <S4 data={standarLayanan} id="preview-s4" />
    </div>

    <!-- Langkah Variants -->
    <div class="pratinjau-variant-wrap" data-variant-code="P1" data-kind="langkah">
      <P1 data={standarLangkah} id="preview-p1" />
    </div>
    <div class="pratinjau-variant-wrap" data-variant-code="P2" data-kind="langkah">
      <P2 data={standarLangkah} id="preview-p2" />
    </div>
    <div class="pratinjau-variant-wrap" data-variant-code="P3" data-kind="langkah">
      <P3 data={standarLangkah} id="preview-p3" />
    </div>

    <!-- Galeri Variants -->
    <div class="pratinjau-variant-wrap" data-variant-code="G1" data-kind="galeri">
      <G1 data={standarGaleri} id="preview-g1" />
    </div>
    <div class="pratinjau-variant-wrap" data-variant-code="G2" data-kind="galeri">
      <G2 data={standarGaleri} id="preview-g2" />
    </div>
    <div class="pratinjau-variant-wrap" data-variant-code="G3" data-kind="galeri">
      <G3 data={standarGaleri} id="preview-g3" />
    </div>

    <!-- Ulasan Variants -->
    <div class="pratinjau-variant-wrap" data-variant-code="U1" data-kind="ulasan">
      <U1 data={standarUlasan} id="preview-u1" />
    </div>
    <div class="pratinjau-variant-wrap" data-variant-code="U2" data-kind="ulasan">
      <U2 data={standarUlasan} id="preview-u2" />
    </div>
    <div class="pratinjau-variant-wrap" data-variant-code="U3" data-kind="ulasan">
      <U3 data={standarUlasan} id="preview-u3" />
    </div>

    <!-- Biaya Variants -->
    <div class="pratinjau-variant-wrap" data-variant-code="B1" data-kind="biaya">
      <B1 data={standarBiaya} id="preview-b1" />
    </div>
    <div class="pratinjau-variant-wrap" data-variant-code="B2" data-kind="biaya">
      <B2 data={standarBiaya} id="preview-b2" />
    </div>
    <div class="pratinjau-variant-wrap" data-variant-code="B3" data-kind="biaya">
      <B3 data={standarBiaya} id="preview-b3" />
    </div>

    <!-- Tanya Jawab Variants -->
    <div class="pratinjau-variant-wrap" data-variant-code="Q1" data-kind="tanya-jawab">
      <Q1 data={standarTanyaJawab} id="preview-q1" />
    </div>
    <div class="pratinjau-variant-wrap" data-variant-code="Q2" data-kind="tanya-jawab">
      <Q2 data={standarTanyaJawab} id="preview-q2" />
    </div>
    <div class="pratinjau-variant-wrap" data-variant-code="Q3" data-kind="tanya-jawab">
      <Q3 data={standarTanyaJawab} id="preview-q3" />
    </div>

    <!-- Lokasi Variants -->
    <div class="pratinjau-variant-wrap" data-variant-code="L1" data-kind="lokasi">
      <L1 data={standarLokasi} id="preview-l1" />
    </div>
    <div class="pratinjau-variant-wrap" data-variant-code="L2" data-kind="lokasi">
      <L2 data={standarLokasi} id="preview-l2" />
    </div>
    <div class="pratinjau-variant-wrap" data-variant-code="L3" data-kind="lokasi">
      <L3 data={standarLokasi} id="preview-l3" />
    </div>

    <!-- CTA Variants -->
    <div class="pratinjau-variant-wrap" data-variant-code="C1" data-kind="cta">
      <C1 data={standarCta} id="preview-c1" />
    </div>
    <div class="pratinjau-variant-wrap" data-variant-code="C2" data-kind="cta">
      <C2 data={standarCta} id="preview-c2" />
    </div>
    <div class="pratinjau-variant-wrap" data-variant-code="C3" data-kind="cta">
      <C3 data={standarCta} id="preview-c3" />
    </div>

    <!-- Footer Variants -->
    <div class="pratinjau-variant-wrap" data-variant-code="F1" data-kind="footer">
      <F1 data={standarFooter} id="preview-f1" />
    </div>
    <div class="pratinjau-variant-wrap" data-variant-code="F2" data-kind="footer">
      <F2 data={standarFooter} id="preview-f2" />
    </div>
    <div class="pratinjau-variant-wrap" data-variant-code="F3" data-kind="footer">
      <F3 data={standarFooter} id="preview-f3" />
    </div>
    <div class="pratinjau-variant-wrap" data-variant-code="F4" data-kind="footer">
      <F4 data={standarFooter} id="preview-f4" />
    </div>
  </div>

  <script is:inline>
    (function () {
      const DEFAULT_RECIPE = 'N1,H1,R1,K1,S1,P1,G1,U1,B1,Q1,L1,C1,F1';
      const container = document.getElementById('pratinjau-root');
      if (!container) return;

      const urlParams = new URLSearchParams(window.location.search);
      const recipeParam = urlParams.get('s');
      const rawRecipe = recipeParam && recipeParam.trim() ? recipeParam : DEFAULT_RECIPE;
      const themeParam = urlParams.get('tema') || urlParams.get('theme');

      if (themeParam === 'gelap' || themeParam === 'dark') {
        document.documentElement.setAttribute('data-theme', 'dark');
      } else if (themeParam === 'terang' || themeParam === 'light') {
        document.documentElement.removeAttribute('data-theme');
      }

      const allWraps = Array.from(container.querySelectorAll('.pratinjau-variant-wrap'));
      const availableCodes = new Set(allWraps.map((w) => w.getAttribute('data-variant-code')));

      let activeCodes = rawRecipe
        .split(',')
        .map((code) => code.trim().toUpperCase())
        .filter((code) => availableCodes.has(code));

      // If no valid codes exist (e.g. invalid query param), fallback gracefully to DEFAULT_RECIPE
      if (activeCodes.length === 0) {
        activeCodes = DEFAULT_RECIPE.split(',');
      }

      // Hide all variants first
      allWraps.forEach((wrap) => {
        wrap.style.display = 'none';
        wrap.removeAttribute('id');
      });

      // Show and reorder according to recipe sequence without duplicate IDs
      const assignedIds = new Set();
      activeCodes.forEach((code) => {
        const target = allWraps.find((w) => w.getAttribute('data-variant-code') === code);
        if (target) {
          const kind = target.getAttribute('data-kind');
          if (kind && !assignedIds.has('section-' + kind)) {
            target.id = 'section-' + kind;
            assignedIds.add('section-' + kind);
          }
          target.style.display = 'block';
          container.appendChild(target);
        }
      });

      // Smooth scroll and anchor interceptor
      document.addEventListener('click', (e) => {
        const anchor = e.target.closest('a');
        if (!anchor) return;
        const href = anchor.getAttribute('href');
        if (!href) return;

        if (href.startsWith('#')) {
          e.preventDefault();
          if (href === '#' || href === '') return;
          const targetEl = document.querySelector(href);
          if (targetEl) {
            targetEl.scrollIntoView({ behavior: 'smooth' });
            history.replaceState(null, '', href);
          }
          return;
        }

        try {
          const parsed = new URL(anchor.href, window.location.href);
          if (parsed.origin === window.location.origin) {
            if (parsed.hash) {
              const targetEl = document.querySelector(parsed.hash);
              if (targetEl) {
                e.preventDefault();
                targetEl.scrollIntoView({ behavior: 'smooth' });
                history.replaceState(null, '', parsed.hash);
                return;
              }
            }
            // Disallow navigating to internal lab routes from pure client preview
            e.preventDefault();
          }
        } catch (err) {}
      });

      // If initial URL has hash, scroll into view
      if (window.location.hash) {
        requestAnimationFrame(() => {
          const initialTarget = document.querySelector(window.location.hash);
          if (initialTarget) {
            initialTarget.scrollIntoView({ behavior: 'smooth' });
          }
        });
      }
    })();
  </script>

  <style>
    .pratinjau-page {
      min-height: 100vh;
      background-color: var(--wf-bg);
      color: var(--wf-ink);
    }

    .pratinjau-variant-wrap {
      display: none;
      width: 100%;
    }
  </style>
</BaseLayout>
