  <script is:inline>
    const descriptions = {
      N1: 'N1 [Brand] | [Menu] | [CTA]',
      N2: 'N2 [Brand] | [Menu + CTA kanan]',
      N3: 'N3 [Menu kiri] | [Brand tengah] | [Menu kanan + CTA]',
      N4: 'N4 [Brand + kontak/jam] / [Menu]',
      H1: 'H1 [Teks] | [Visual]',
      H2: 'H2 [Teks terpusat]',
      H3: 'H3 [Visual penuh latar] + teks kiri bawah',
      H4: 'H4 [Teks] | [Kartu info ringkas]',
      S1: 'S1 Grid kartu berjenjang',
      S2: 'S2 Daftar baris [Nama][Deskripsi][Harga]',
      S3: 'S3 [Judul tetap] | [Daftar]',
      S4: 'S4 Kartu bergantian kiri-kanan',
      F1: 'F1 Empat kolom modular',
      F2: 'F2 Satu baris horizontal',
      F3: 'F3 Terpusat bertumpuk',
      F4: 'F4 [CTA besar] / [baris legal]',
      P1: 'P1 [Nomor][Judul][Teks] 3-4 kolom horizontal',
      P2: 'P2 [Nomor] [Judul + Teks] timeline vertikal',
      P3: 'P3 Grid 2x2 kartu, nomor besar',
      K1: 'K1 3 kolom [Placeholder ikon][Judul][Teks]',
      K2: 'K2 Daftar satu kolom garis pemisah',
      K3: 'K3 [Pernyataan besar] | [Poin kecil bertumpuk]',
      L1: 'L1 [Peta] | [Info: alamat, jam, tombol Maps]',
      L2: 'L2 Peta penuh lebar kartu menimpa sudut',
      L3: 'L3 Info bertumpuk tanpa peta',
      C1: 'C1 Banner satu baris [Teks] | [Tombol]',
      C2: 'C2 Terpusat [Judul / teks / tombol]',
      C3: 'C3 Kartu terbungkus [Judul / teks / tombol] + kontak',
      G1: 'G1 Grid 3 kolom seragam [Visual / Judul / Keterangan]',
      G2: 'G2 Susunan asimetris (bento) di 1280px',
      G3: 'G3 Daftar perbandingan 2 kolom [Visual A | Visual B]',
      U1: 'U1 Grid 3 kolom kartu sejajar [Kutipan / Penulis + Konteks]',
      U2: 'U2 [Header kolom kiri] | [Grid 2 kolom ulasan di kanan]',
      U3: 'U3 Daftar satu kolom penuh garis pemisah',
      B1: 'B1 Grid kartu vertikal sejajar',
      B2: 'B2 Daftar baris horizontal bertumpuk',
      B3: 'B3 Tata letak terpisah per item',
      Q1: 'Q1 Satu kolom terpusat akordeon details/summary',
      Q2: 'Q2 [Header kolom kiri] | [Akordeon bertumpuk di kanan]',
      Q3: 'Q3 Grid 2 kolom terbuka',
      R1: 'R1 [Teks kiri] | [Visual kanan] / [Metrics] / [Mitra]',
      R2: 'R2 Terpusat bertumpuk tanpa visual',
      R3: 'R3 [Visual tinggi kiri] | [Konten kanan]'
    };

    function setSectionVariant(kind, variant) {
      const renderArea = document.querySelector(`[data-render-kind="${kind}"]`);
      if (!renderArea) return;

      const items = renderArea.querySelectorAll('.galeri-variant-item');
      const buttons = document.querySelectorAll(`[data-kind="${kind}"].galeri-btn`);
      const viewToggle = document.querySelector(`[data-view-toggle="${kind}"]`);

      buttons.forEach((btn) => {
        const isActive = btn.getAttribute('data-variant') === variant;
        btn.classList.toggle('active', isActive);
        btn.setAttribute('aria-pressed', String(isActive));
      });

      const descEl = document.getElementById(`${kind}-active-desc`);
      if (descEl) {
        descEl.textContent = variant === 'all' ? 'Menampilkan semua varian komparasi' : (descriptions[variant] || variant);
      }

      if (viewToggle) {
        viewToggle.style.display = variant === 'all' ? 'inline-flex' : 'none';
      }

      items.forEach((item) => {
        if (variant === 'all') {
          item.classList.add('active');
        } else {
          item.classList.toggle('active', item.getAttribute('data-variant-box') === variant);
        }
      });
    }

    document.querySelectorAll('.galeri-mode-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const kind = btn.getAttribute('data-kind');
        const mode = btn.getAttribute('data-mode');
        const renderArea = document.querySelector(`[data-render-kind="${kind}"]`);
        if (!renderArea) return;

        const siblings = document.querySelectorAll(`[data-view-toggle="${kind}"] .galeri-mode-btn`);
        siblings.forEach((s) => {
          const isActive = s === btn;
          s.classList.toggle('active', isActive);
          s.setAttribute('aria-pressed', String(isActive));
        });

        if (mode === 'side') {
          renderArea.classList.add('is-side-by-side');
        } else {
          renderArea.classList.remove('is-side-by-side');
        }
      });
    });

    document.querySelectorAll('.galeri-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const kind = btn.getAttribute('data-kind');
        const variant = btn.getAttribute('data-variant');
        if (kind && variant) {
          setSectionVariant(kind, variant);
        }
      });
    });

    // Add Gunakan di Perakit button to each toolbar
    document.querySelectorAll('.galeri-toolbar').forEach((tb) => {
      const kind = tb.getAttribute('data-section-kind');
      const controls = tb.querySelector('.galeri-toolbar-controls');
      if (controls && kind) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'wf-btn galeri-btn galeri-btn-use';
        btn.textContent = 'Gunakan di Perakit';
        btn.title = 'Gunakan varian aktif ini di Perakit Halaman';
        btn.addEventListener('click', () => {
          const activeBtn = tb.querySelector(`.galeri-btn.active[data-kind="${kind}"]`);
          const variant = activeBtn ? activeBtn.getAttribute('data-variant') : null;
          if (variant && variant !== 'all') {
            window.location.href = `/?set=${variant}`;
          } else {
            window.location.href = '/';
          }
        });
        controls.appendChild(btn);
      }
    });

    // Initialize initial ARIA states
    document.querySelectorAll('.galeri-btn, .galeri-mode-btn').forEach((btn) => {
      btn.setAttribute('aria-pressed', String(btn.classList.contains('active')));
    });

    const params = new URLSearchParams(window.location.search);
    const targetSection = params.get('section');
    const targetVariant = params.get('variant');
    const isClean = params.get('clean') === '1';

    const validSections = [
      'navbar', 'hero', 'layanan', 'footer',
      'langkah', 'keunggulan', 'lokasi', 'cta',
      'galeri', 'ulasan', 'biaya', 'tanya-jawab', 'profil'
    ];
    if (targetSection) {
      if (validSections.includes(targetSection)) {
        validSections.forEach((k) => {
          const group = document.getElementById(`section-${k}-group`);
          if (group) {
            if (k === targetSection) {
              group.style.display = 'block';
              if (targetVariant) {
                setSectionVariant(k, targetVariant);
              }
            } else {
              group.style.display = 'none';
            }
          }
        });
      } else {
        const notice = document.getElementById('galeri-param-notice');
        const noticeText = document.getElementById('galeri-param-notice-text');
        if (notice && noticeText) {
          notice.style.display = 'flex';
          noticeText.textContent = `Parameter section "${targetSection}" tidak dikenali. Seluruh section ditampilkan secara lengkap.`;
        }
      }

      if (isClean) {
        const intro = document.getElementById('galeri-header-intro');
        if (intro) intro.style.display = 'none';
        const jumpBar = document.getElementById('galeri-sticky-jump-bar');
        if (jumpBar) jumpBar.style.display = 'none';
        document.querySelectorAll('.galeri-toolbar, .galeri-variant-tag').forEach((el) => {
          el.style.display = 'none';
        });
      }
    }
  </script>

  <style>
