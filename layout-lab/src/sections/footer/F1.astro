---
import type { FooterData } from '../../schema/footer';

interface Props {
  data: FooterData;
  id?: string;
}

const { data, id = 'f1' } = Astro.props;
---

<footer class="wf-footer f1" id={id}>
  <div class="wf-container">
    <div class="f1-brand-row">
      <div class="f1-brand-name">{data.brand}</div>
      <p class="f1-brand-desc wf-break-word">{data.deskripsi}</p>
    </div>

    {(!data.kolom || data.kolom.length === 0) ? (
      <div class="wf-empty-state">
        <div class="wf-empty-title">Navigasi Kolom Belum Tersedia</div>
        <p class="wf-empty-desc">Tidak ada kolom navigasi footer yang terkonfigurasi saat ini.</p>
      </div>
    ) : (
      <div class="f1-grid">
        {data.kolom.map((col) => (
          <div class="f1-col">
            <h4 class="f1-col-title">{col.judul}</h4>
            <ul class="f1-col-list">
              {col.tautan.map((link) => (
                <li>
                  <a href={link.href} class="f1-link">{link.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    )}

    <div class="f1-legal">
      <div class="f1-copyright">{data.legal.hakCipta}</div>
      <ul class="f1-legal-links">
        {data.legal.tautan.map((item) => (
          <li>
            <a href={item.href} class="f1-legal-link">{item.label}</a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</footer>

<style>
  .f1 {
    background-color: var(--wf-bg);
    border-top: 2px solid var(--wf-line);
    padding-top: var(--wf-space-6);
    padding-bottom: var(--wf-space-5);
  }

  .f1-brand-row {
    margin-bottom: var(--wf-space-6);
    padding-bottom: var(--wf-space-4);
    border-bottom: 1px solid var(--wf-line);
    max-width: 48rem;
  }

  .f1-brand-name {
    font-size: 1.125rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    margin-bottom: var(--wf-space-2);
  }

  .f1-brand-desc {
    font-size: 0.875rem;
    color: var(--wf-ink);
    line-height: 1.5;
  }

  .f1-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--wf-space-5);
    margin-bottom: var(--wf-space-6);
  }

  .f1-col-title {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    margin-bottom: var(--wf-space-3);
    color: var(--wf-ink);
  }

  .f1-col-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--wf-space-2);
  }

  .f1-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.875rem;
    color: var(--wf-ink);
    text-decoration: none;
    padding-block: var(--wf-space-1);
  }

  .f1-link:hover {
    text-decoration: underline;
  }

  .f1-legal {
    padding-top: var(--wf-space-4);
    border-top: 1px solid var(--wf-line);
    display: flex;
    flex-direction: column;
    gap: var(--wf-space-3);
  }

  .f1-copyright {
    font-size: 0.8125rem;
    color: var(--wf-ink);
  }

  .f1-legal-links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--wf-space-3);
  }

  .f1-legal-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.8125rem;
    color: var(--wf-ink);
    text-decoration: none;
    padding: var(--wf-space-1) var(--wf-space-2);
  }

  .f1-legal-link:hover {
    text-decoration: underline;
  }

  /* 768px tablet layout: 2 columns */
  @media (min-width: 768px) {
    .f1-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .f1-legal {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  /* 1280px / >=1024px desktop layout: 4 columns */
  @media (min-width: 1024px) {
    .f1 {
      padding-top: var(--wf-space-8);
      padding-bottom: var(--wf-space-6);
    }

    .f1-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--wf-space-6);
    }
  }
</style>
