---
import type { FooterData } from '../../schema/footer';

interface Props {
  data: FooterData;
  id?: string;
}

const { data, id = 'f3' } = Astro.props;
const allLinks = data.kolom.flatMap((c) => c.tautan);
---

<footer class="wf-footer f3" id={id}>
  <div class="wf-container">
    <div class="f3-inner">
      <div class="f3-brand">
        <span class="f3-brand-name">{data.brand}</span>
      </div>

      <p class="f3-desc wf-break-word">{data.deskripsi}</p>

      <nav class="f3-nav" aria-label="Navigasi Terpusat F3">
        <ul class="f3-links">
          {allLinks.map((item) => (
            <li>
              <a href={item.href} class="f3-link">{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="f3-divider"></div>

      <div class="f3-legal">
        <div class="f3-copyright">{data.legal.hakCipta}</div>
        <ul class="f3-legal-links">
          {data.legal.tautan.map((item) => (
            <li>
              <a href={item.href} class="f3-legal-link">{item.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</footer>

<style>
  .f3 {
    background-color: var(--wf-bg);
    border-top: 1px solid var(--wf-line);
    padding-block: var(--wf-space-6);
  }

  .f3-inner {
    max-width: 48rem;
    margin-inline: auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--wf-space-3);
  }

  .f3-brand-name {
    font-size: 1.125rem;
    font-weight: 800;
    letter-spacing: 0.02em;
  }

  .f3-desc {
    font-size: 0.875rem;
    color: var(--wf-ink);
    line-height: 1.6;
    max-width: 36rem;
  }

  .f3-links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--wf-space-2) var(--wf-space-4);
    margin-top: var(--wf-space-2);
  }

  .f3-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.875rem;
    color: var(--wf-ink);
    text-decoration: none;
    padding: var(--wf-space-1) var(--wf-space-2);
  }

  .f3-link:hover {
    text-decoration: underline;
  }

  .f3-divider {
    width: 64px;
    height: 1px;
    background-color: var(--wf-line);
    margin-block: var(--wf-space-2);
  }

  .f3-legal {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--wf-space-2);
  }

  .f3-copyright {
    font-size: 0.8125rem;
    color: var(--wf-line);
  }

  .f3-legal-links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--wf-space-3);
  }

  .f3-legal-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.75rem;
    color: var(--wf-line);
    text-decoration: none;
    padding: var(--wf-space-1) var(--wf-space-2);
  }

  .f3-legal-link:hover {
    text-decoration: underline;
  }

  /* 1280px / >=1024px desktop layout: terpusat bertumpuk dengan ruang lega */
  @media (min-width: 1024px) {
    .f3 {
      padding-block: var(--wf-space-8);
    }

    .f3-inner {
      gap: var(--wf-space-4);
    }

    .f3-links {
      gap: var(--wf-space-3) var(--wf-space-6);
    }
  }
</style>
