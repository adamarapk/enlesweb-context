---
import type { HeroData } from '../../schema/hero';

interface Props {
  data: HeroData;
  id?: string;
}

const { data, id = 'h3' } = Astro.props;
---

<section class="wf-hero h3" id={id}>
  <div class="wf-container">
    <div class={`h3-stage ${!data.visual ? 'h3-stage-fallback' : ''}`}>
      <div class="h3-bg-indicator">
        <span>{data.visual ? data.visual.label : 'Kanvas arsitektural struktur'}</span>
      </div>

      <div class="h3-card">
        <h1 class="h3-title wf-break-word">{data.judul}</h1>
        <p class="h3-desc wf-break-word">{data.subjudul}</p>

        <div class="h3-actions">
          <a href={data.ctaUtama.href} class="wf-btn wf-btn-primary">{data.ctaUtama.label}</a>
          {data.ctaSekunder && (
            <a href={data.ctaSekunder.href} class="wf-btn wf-btn-secondary">{data.ctaSekunder.label}</a>
          )}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .h3 {
    padding-block: var(--wf-space-5);
    border-bottom: 1px solid var(--wf-line);
    background-color: var(--wf-bg);
  }

  .h3-stage {
    position: relative;
    width: 100%;
    min-height: 420px;
    background-color: var(--wf-fill);
    border: 1px solid var(--wf-line);
    border-radius: var(--wf-radius);
    padding: var(--wf-space-4);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .h3-stage-fallback {
    background-color: var(--wf-bg);
    border: 2px dashed var(--wf-line);
  }

  .h3-bg-indicator {
    position: absolute;
    top: var(--wf-space-4);
    right: var(--wf-space-4);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--wf-ink);
    background-color: var(--wf-bg);
    border: 1px solid var(--wf-line);
    padding: var(--wf-space-1) var(--wf-space-3);
    border-radius: var(--wf-radius);
    user-select: none;
  }

  .h3-card {
    background-color: var(--wf-bg);
    border: 1px solid var(--wf-line);
    border-radius: var(--wf-radius);
    padding: var(--wf-space-5);
    max-width: 100%;
    z-index: 1;
  }

  .h3-title {
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.02em;
    margin-bottom: var(--wf-space-2);
  }

  .h3-desc {
    font-size: 0.9375rem;
    color: var(--wf-ink);
    margin-bottom: var(--wf-space-4);
    line-height: 1.6;
  }

  .h3-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--wf-space-3);
  }

  .h3-actions .wf-btn {
    flex: 1 1 130px;
    text-align: center;
  }

  /* 1280px / >=1024px desktop layout: [Visual penuh latar] + teks kiri bawah */
  @media (min-width: 1024px) {
    .h3-stage {
      min-height: 520px;
      padding: var(--wf-space-7);
    }

    .h3-card {
      max-width: 38rem;
      padding: var(--wf-space-6);
    }

    .h3-title {
      font-size: 2.25rem;
    }

    .h3-actions .wf-btn {
      flex: 0 0 auto;
    }
  }
</style>
