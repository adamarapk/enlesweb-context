---
import type { LayananData } from '../../schema/layanan';

interface Props {
  data: LayananData;
  id?: string;
}

const { data, id = 's2' } = Astro.props;
---

<section class="wf-layanan s2" id={id}>
  <div class="wf-container">
    <div class="s2-header">
      <h2 class="s2-title wf-break-word">{data.judul}</h2>
      <p class="s2-desc wf-break-word">{data.subjudul}</p>
    </div>

    {data.status === 'loading' ? (
      <div class="wf-state-indicator">
        <div class="wf-state-content">
          <span class="wf-state-mark">Memuat</span>
          <span class="wf-state-text">{data.pesanStatus || 'Sedang memuat data modul layanan...'}</span>
        </div>
      </div>
    ) : data.status === 'error' ? (
      <div class="wf-state-indicator">
        <div class="wf-state-content">
          <span class="wf-state-mark">Galat</span>
          <span class="wf-state-text">{data.pesanStatus || 'Gagal memuat modul layanan. Silakan coba muat ulang.'}</span>
        </div>
        <a href="/uji?mode=status" class="wf-btn wf-btn-secondary wf-state-action">Muat Ulang</a>
      </div>
    ) : (!data.daftar || data.daftar.length === 0) ? (
      <div class="wf-empty-state">
        <div class="wf-empty-title">Belum Ada Modul Layanan</div>
        <p class="wf-empty-desc">{data.pesanStatus || 'Tidak ada modul layanan terdaftar dalam konfigurasi data saat ini.'}</p>
        <a href="/uji" class="wf-btn wf-btn-secondary">Pilih Dataset Lain</a>
      </div>
    ) : (
      <div class="s2-table">
        <div class="s2-table-head" aria-hidden="true">
          <div class="s2-col-name">Nama Modul</div>
          <div class="s2-col-desc">Deskripsi Spesifikasi</div>
          <div class="s2-col-price">Estimasi Biaya</div>
        </div>

        <div class="s2-rows">
          {data.daftar.map((item) => (
            <div class={`s2-row ${item.utama ? 's2-row-featured' : ''}`}>
              <div class="s2-col-name">
                <h3 class="s2-name wf-break-word">{item.nama}</h3>
              </div>

              <div class="s2-col-desc">
                <p class="s2-desc-text wf-break-word">{item.deskripsi}</p>
              </div>

              <div class="s2-col-price">
                <span class="s2-price-val">{item.harga}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .s2 {
    padding-block: var(--wf-space-6);
    border-bottom: 1px solid var(--wf-line);
    background-color: var(--wf-bg);
  }

  .s2-header {
    margin-bottom: var(--wf-space-6);
    max-width: 48rem;
  }

  .s2-title {
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.01em;
    margin-bottom: var(--wf-space-2);
  }

  .s2-desc {
    font-size: 0.9375rem;
    color: var(--wf-ink);
    line-height: 1.6;
  }

  .s2-table {
    border: 1px solid var(--wf-line);
    border-radius: var(--wf-radius);
    background-color: var(--wf-bg);
    overflow: hidden;
  }

  .s2-table-head {
    display: none;
    background-color: var(--wf-fill);
    border-bottom: 2px solid var(--wf-line);
    padding: var(--wf-space-3) var(--wf-space-4);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--wf-ink);
  }

  .s2-rows {
    display: flex;
    flex-direction: column;
  }

  .s2-row {
    padding: var(--wf-space-4);
    border-bottom: 1px solid var(--wf-line);
    display: flex;
    flex-direction: column;
    gap: var(--wf-space-2);
  }

  .s2-row:last-child {
    border-bottom: none;
  }

  .s2-row-featured {
    background-color: var(--wf-fill);
  }


  .s2-name {
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .s2-desc-text {
    font-size: 0.875rem;
    color: var(--wf-ink);
    line-height: 1.5;
  }

  .s2-price-val {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--wf-ink);
    overflow-wrap: break-word;
    word-break: break-word;
  }

  /* >=768px tablet & >=1024px desktop layout: 3 horizontal columns [Nama][Deskripsi][Harga] */
  @media (min-width: 768px) {
    .s2-table-head {
      display: grid;
      grid-template-columns: 3fr 5fr 2fr;
      gap: var(--wf-space-4);
      align-items: center;
    }

    .s2-row {
      display: grid;
      grid-template-columns: 3fr 5fr 2fr;
      gap: var(--wf-space-4);
      align-items: center;
    }

    .s2-col-price {
      text-align: right;
    }
  }

  @media (min-width: 1024px) {
    .s2 {
      padding-block: var(--wf-space-8);
    }

    .s2-title {
      font-size: 2rem;
    }

    .s2-table-head,
    .s2-row {
      padding-inline: var(--wf-space-5);
    }
  }
</style>
