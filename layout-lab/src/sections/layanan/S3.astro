---
import type { LayananData } from '../../schema/layanan';

interface Props {
  data: LayananData;
  id?: string;
}

const { data, id = 's3' } = Astro.props;
---

<section class="wf-layanan s3" id={id}>
  <div class="wf-container">
    <div class="s3-layout">
      <aside class="s3-sidebar">
        <div class="s3-sticky-wrap">
          <h2 class="s3-title wf-break-word">{data.judul}</h2>
          <p class="s3-desc wf-break-word">{data.subjudul}</p>
        </div>
      </aside>

      <div class="s3-content">
        {data.status === 'loading' ? (
          <div class="wf-state-indicator">
            <div class="wf-state-content">
              <span class="wf-state-mark">Memuat</span>
              <span class="wf-state-text">{data.pesanStatus || 'Sedang memuat data modul layanan...'}</span>
            </div>
          </div>
        ) : data.status === 'error' ? (
          <div class="wf-state-indicator">
            <div class="wf-state-content">
              <span class="wf-state-mark">Galat</span>
              <span class="wf-state-text">{data.pesanStatus || 'Gagal memuat modul layanan. Silakan coba muat ulang.'}</span>
            </div>
            <a href="/uji?mode=status" class="wf-btn wf-btn-secondary wf-state-action">Muat Ulang</a>
          </div>
        ) : (!data.daftar || data.daftar.length === 0) ? (
          <div class="wf-empty-state">
            <div class="wf-empty-title">Belum Ada Modul Layanan</div>
            <p class="wf-empty-desc">{data.pesanStatus || 'Tidak ada modul layanan terdaftar dalam konfigurasi data saat ini.'}</p>
            <a href="/uji" class="wf-btn wf-btn-secondary">Pilih Dataset Lain</a>
          </div>
        ) : (
          <div class="s3-list">
            {data.daftar.map((item) => (
              <article class={`s3-card ${item.utama ? 's3-card-featured' : ''}`}>
                <h3 class="s3-card-title wf-break-word">{item.nama}</h3>
                <p class="s3-card-desc wf-break-word">{item.deskripsi}</p>

                <div class="s3-card-bottom">
                  <span class="s3-card-price">{item.harga}</span>
                </div>
              </article>
            ))}
          </div>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .s3 {
    padding-block: var(--wf-space-6);
    border-bottom: 1px solid var(--wf-line);
    background-color: var(--wf-bg);
  }

  .s3-layout {
    display: flex;
    flex-direction: column;
    gap: var(--wf-space-6);
  }

  .s3-title {
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.01em;
    margin-bottom: var(--wf-space-2);
  }

  .s3-desc {
    font-size: 0.9375rem;
    color: var(--wf-ink);
    line-height: 1.6;
    margin-bottom: var(--wf-space-4);
  }


  .s3-list {
    display: flex;
    flex-direction: column;
    gap: var(--wf-space-4);
  }

  .s3-card {
    border: 1px solid var(--wf-line);
    border-radius: var(--wf-radius);
    padding: var(--wf-space-4);
    background-color: var(--wf-bg);
    display: flex;
    flex-direction: column;
    gap: var(--wf-space-2);
  }

  .s3-card-featured {
    border: 2px solid var(--wf-ink);
    background-color: var(--wf-fill);
  }


  .s3-card-title {
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .s3-card-desc {
    font-size: 0.875rem;
    color: var(--wf-ink);
    line-height: 1.5;
  }

  .s3-card-bottom {
    padding-top: var(--wf-space-2);
    border-top: 1px dashed var(--wf-line);
    margin-top: var(--wf-space-2);
  }

  .s3-card-price {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--wf-ink);
    overflow-wrap: break-word;
    word-break: break-word;
  }

  /* 1280px / >=1024px desktop layout: [Judul tetap] | [Daftar] */
  @media (min-width: 1024px) {
    .s3 {
      padding-block: var(--wf-space-8);
    }

    .s3-layout {
      display: grid;
      grid-template-columns: 4fr 8fr;
      gap: var(--wf-space-7);
      align-items: start;
    }

    .s3-title {
      font-size: 2rem;
    }

    .s3-sticky-wrap {
      position: sticky;
      top: var(--wf-space-6);
    }

    .s3-card {
      padding: var(--wf-space-5);
    }
  }
</style>
