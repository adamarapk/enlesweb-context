---
import type { LayananData } from '../../schema/layanan';

interface Props {
  data: LayananData;
  id?: string;
}

const { data, id = 's4' } = Astro.props;
---

<section class="wf-layanan s4" id={id}>
  <div class="wf-container">
    <div class="s4-header">
      <h2 class="s4-title wf-break-word">{data.judul}</h2>
      <p class="s4-desc wf-break-word">{data.subjudul}</p>
    </div>

    {data.status === 'loading' ? (
      <div class="wf-state-indicator">
        <div class="wf-state-content">
          <span class="wf-state-mark">Memuat</span>
          <span class="wf-state-text">{data.pesanStatus || 'Sedang memuat data modul layanan...'}</span>
        </div>
      </div>
    ) : data.status === 'error' ? (
      <div class="wf-state-indicator">
        <div class="wf-state-content">
          <span class="wf-state-mark">Galat</span>
          <span class="wf-state-text">{data.pesanStatus || 'Gagal memuat modul layanan. Silakan coba muat ulang.'}</span>
        </div>
        <a href="/uji?mode=status" class="wf-btn wf-btn-secondary wf-state-action">Muat Ulang</a>
      </div>
    ) : (!data.daftar || data.daftar.length === 0) ? (
      <div class="wf-empty-state">
        <div class="wf-empty-title">Belum Ada Modul Layanan</div>
        <p class="wf-empty-desc">{data.pesanStatus || 'Tidak ada modul layanan terdaftar dalam konfigurasi data saat ini.'}</p>
        <a href="/uji" class="wf-btn wf-btn-secondary">Pilih Dataset Lain</a>
      </div>
    ) : (
      <div class="s4-stack">
        {data.daftar.map((item, index) => {
          const isOdd = index % 2 === 1;
          const indexStr = String(index + 1).padStart(2, '0');
          return (
            <article class={`s4-row ${isOdd ? 's4-row-reversed' : ''} ${item.utama ? 's4-row-featured' : ''}`}>
              <div class="s4-text-block">
                <h3 class="s4-name wf-break-word">{item.nama}</h3>
                <p class="s4-desc-text wf-break-word">{item.deskripsi}</p>

                <div class="s4-price-box">
                  <span class="s4-price">{item.harga}</span>
                </div>
              </div>

              <div class="s4-visual-block">
                {item.visual ? (
                  <div class="wf-visual s4-visual-box">
                    <span>{item.visual.label}</span>
                  </div>
                ) : (
                  <div class="s4-index-box">
                    <span class="s4-index-num">[{indexStr}]</span>
                    <span class="s4-index-label">Blok struktur</span>
                  </div>
                )}
              </div>
            </article>
          );
        })}
      </div>
    )}
  </div>
</section>

<style>
  .s4 {
    padding-block: var(--wf-space-6);
    border-bottom: 1px solid var(--wf-line);
    background-color: var(--wf-bg);
  }

  .s4-header {
    margin-bottom: var(--wf-space-6);
    max-width: 48rem;
  }

  .s4-title {
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.01em;
    margin-bottom: var(--wf-space-2);
  }

  .s4-desc {
    font-size: 0.9375rem;
    color: var(--wf-ink);
    line-height: 1.6;
  }

  .s4-stack {
    display: flex;
    flex-direction: column;
    gap: var(--wf-space-6);
  }

  .s4-row {
    border: 1px solid var(--wf-line);
    border-radius: var(--wf-radius);
    padding: var(--wf-space-4);
    background-color: var(--wf-bg);
    display: flex;
    flex-direction: column;
    gap: var(--wf-space-4);
  }

  .s4-row-featured {
    border: 2px solid var(--wf-ink);
  }

  .s4-text-block {
    display: flex;
    flex-direction: column;
    gap: var(--wf-space-2);
  }


  .s4-name {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .s4-desc-text {
    font-size: 0.875rem;
    color: var(--wf-ink);
    line-height: 1.5;
  }

  .s4-price-box {
    padding-top: var(--wf-space-2);
  }

  .s4-price {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--wf-ink);
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .s4-visual-block {
    width: 100%;
  }

  .s4-visual-box {
    width: 100%;
    min-height: 180px;
  }

  .s4-index-box {
    width: 100%;
    min-height: 180px;
    background-color: var(--wf-fill);
    border: 1px solid var(--wf-line);
    border-radius: var(--wf-radius);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--wf-space-1);
  }

  .s4-index-num {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 2.25rem;
    font-weight: 800;
    color: var(--wf-ink);
  }

  .s4-index-label {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--wf-line);
    letter-spacing: 0.02em;
  }

  /* 1280px / >=1024px desktop layout: 2 columns alternating left-right */
  @media (min-width: 1024px) {
    .s4 {
      padding-block: var(--wf-space-8);
    }

    .s4-title {
      font-size: 2rem;
    }

    .s4-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: var(--wf-space-7);
      padding: var(--wf-space-6);
    }

    .s4-row-reversed .s4-text-block {
      order: 2;
    }

    .s4-row-reversed .s4-visual-block {
      order: 1;
    }

    .s4-visual-box,
    .s4-index-box {
      min-height: 220px;
    }
  }
</style>
