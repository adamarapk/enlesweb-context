---
import type { LayananData } from '../../schema/layanan';

interface Props {
  data: LayananData;
  id?: string;
}

const { data, id = 's1' } = Astro.props;
---

<section class="wf-layanan s1" id={id}>
  <div class="wf-container">
    <div class="s1-header">
      <h2 class="s1-title wf-break-word">{data.judul}</h2>
      <p class="s1-desc wf-break-word">{data.subjudul}</p>
    </div>

    {data.status === 'loading' ? (
      <div class="wf-state-indicator">
        <div class="wf-state-content">
          <span class="wf-state-mark">Memuat</span>
          <span class="wf-state-text">{data.pesanStatus || 'Sedang memuat data modul layanan...'}</span>
        </div>
      </div>
    ) : data.status === 'error' ? (
      <div class="wf-state-indicator">
        <div class="wf-state-content">
          <span class="wf-state-mark">Galat</span>
          <span class="wf-state-text">{data.pesanStatus || 'Gagal memuat modul layanan. Silakan coba muat ulang.'}</span>
        </div>
        <a href="/uji?mode=status" class="wf-btn wf-btn-secondary wf-state-action">Muat Ulang</a>
      </div>
    ) : (!data.daftar || data.daftar.length === 0) ? (
      <div class="wf-empty-state">
        <div class="wf-empty-title">Belum Ada Modul Layanan</div>
        <p class="wf-empty-desc">{data.pesanStatus || 'Tidak ada modul layanan terdaftar dalam konfigurasi data saat ini.'}</p>
        <a href="/uji" class="wf-btn wf-btn-secondary">Pilih Dataset Lain</a>
      </div>
    ) : (
      <div class="s1-grid">
        {data.daftar.map((item) => (
          <article class={`s1-card ${item.utama ? 's1-card-featured' : ''}`}>
            {item.visual && (
              <div class="wf-visual s1-card-visual">
                <span>{item.visual.label}</span>
              </div>
            )}

            <div class="s1-card-body">
              <h3 class="s1-card-title wf-break-word">{item.nama}</h3>
              <p class="s1-card-desc wf-break-word">{item.deskripsi}</p>
            </div>

            <div class="s1-card-footer">
              <div class="s1-card-price">{item.harga}</div>
            </div>
          </article>
        ))}
      </div>
    )}
  </div>
</section>

<style>
  .s1 {
    padding-block: var(--wf-space-6);
    border-bottom: 1px solid var(--wf-line);
    background-color: var(--wf-bg);
  }

  .s1-header {
    margin-bottom: var(--wf-space-6);
    max-width: 48rem;
  }

  .s1-title {
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.01em;
    margin-bottom: var(--wf-space-2);
  }

  .s1-desc {
    font-size: 0.9375rem;
    color: var(--wf-ink);
    line-height: 1.6;
  }

  .s1-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--wf-space-4);
  }

  .s1-card {
    border: 1px solid var(--wf-line);
    border-radius: var(--wf-radius);
    background-color: var(--wf-bg);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .s1-card-featured {
    border: 2px solid var(--wf-ink);
  }

  .s1-card-visual {
    width: 100%;
    height: 140px;
    border-bottom: 1px solid var(--wf-line);
    border-radius: 0;
  }

  .s1-card-body {
    padding: var(--wf-space-4);
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }


  .s1-card-title {
    font-size: 1.125rem;
    font-weight: 700;
    margin-bottom: var(--wf-space-2);
    line-height: 1.3;
  }

  .s1-card-desc {
    font-size: 0.875rem;
    color: var(--wf-ink);
    line-height: 1.5;
    flex-grow: 1;
  }

  .s1-card-footer {
    padding: var(--wf-space-3) var(--wf-space-4);
    border-top: 1px solid var(--wf-line);
    background-color: var(--wf-fill);
  }

  .s1-card-price {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--wf-ink);
    overflow-wrap: break-word;
    word-break: break-word;
  }

  /* 768px tablet layout: 2 columns */
  @media (min-width: 768px) {
    .s1-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* 1280px / >=1024px desktop layout: 3 columns */
  @media (min-width: 1024px) {
    .s1 {
      padding-block: var(--wf-space-8);
    }

    .s1-title {
      font-size: 2rem;
    }

    .s1-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--wf-space-5);
    }
  }
</style>
