---
import type { ProfilData } from '../../schema/profil';

interface Props {
  data: ProfilData;
  id?: string;
}

const { data, id = 'r3' } = Astro.props;
---

<section class="wf-profil r3" id={id}>
  <div class="wf-container">
    {data.status === 'loading' ? (
      <div class="wf-state-indicator" role="status" aria-live="polite">
        <div class="wf-state-content">
          <span class="wf-state-mark">Memuat</span>
          <span class="wf-state-text">{data.pesanStatus || 'Sedang memuat data profil...'}</span>
        </div>
      </div>
    ) : data.status === 'error' ? (
      <div class="wf-state-indicator" role="alert" aria-live="assertive">
        <div class="wf-state-content">
          <span class="wf-state-mark">Galat</span>
          <span class="wf-state-text">{data.pesanStatus || 'Gagal memuat profil. Silakan coba muat ulang.'}</span>
        </div>
        <a href="/uji" class="wf-btn wf-btn-secondary wf-state-action">Muat Ulang</a>
      </div>
    ) : (data.status === 'empty' || !data.body) ? (
      <div class="wf-empty-state">
        <h3 class="wf-empty-title">Belum Ada Informasi Profil</h3>
        <p class="wf-empty-desc">{data.pesanStatus || 'Tidak ada konten profil yang terdaftar saat ini.'}</p>
        <a href="/uji" class="wf-btn wf-btn-secondary">Pilih Dataset Lain</a>
      </div>
    ) : (
      <div class="r3-layout">
        <div class="wf-visual r3-visual">Visual</div>

        <div class="r3-right">
          <div class="r3-header-block">
            <h2 class="r3-title wf-break-word">{data.title}</h2>
            {data.intro && <p class="r3-intro wf-break-word">{data.intro}</p>}
            <p class="r3-body wf-break-word">{data.body}</p>
          </div>

          {data.metrics && data.metrics.length > 0 && (
            <div class="r3-metrics-stack">
              {data.metrics.map((metric) => (
                <div class="r3-metric-item">
                  <div class="r3-metric-value">{metric.value}</div>
                  <div class="r3-metric-desc wf-break-word">{metric.description}</div>
                </div>
              ))}
            </div>
          )}

          {data.partners && data.partners.length > 0 && (
            <div class="r3-partners-wrap">
              <div class="r3-partners-grid">
                {data.partners.map((partner) => (
                  <div class="r3-partner-card wf-break-word">{partner}</div>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .r3 {
    padding-block: var(--wf-space-6);
    border-bottom: 1px solid var(--wf-line);
    background-color: var(--wf-bg);
  }

  .r3-layout {
    display: flex;
    flex-direction: column;
    gap: var(--wf-space-6);
  }

  .r3-visual {
    width: 100%;
    aspect-ratio: 16 / 10;
    min-height: 220px;
    order: 2;
  }

  .r3-right {
    display: flex;
    flex-direction: column;
    gap: var(--wf-space-6);
    order: 1;
  }

  .r3-header-block {
    display: flex;
    flex-direction: column;
    gap: var(--wf-space-3);
  }

  .r3-title {
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1.25;
  }

  .r3-intro {
    font-size: 0.9375rem;
    color: var(--wf-ink);
    line-height: 1.6;
  }

  .r3-body {
    font-size: 0.9375rem;
    color: var(--wf-ink);
    line-height: 1.6;
  }

  .r3-metrics-stack {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--wf-space-4);
    border-top: 1px solid var(--wf-line);
    padding-top: var(--wf-space-5);
  }

  .r3-metric-item {
    border: 1px solid var(--wf-line);
    border-radius: var(--wf-radius);
    padding: var(--wf-space-4);
    background-color: var(--wf-bg);
    display: flex;
    flex-direction: column;
    gap: var(--wf-space-1);
  }

  .r3-metric-value {
    font-size: 1.875rem;
    font-weight: 800;
    line-height: 1.1;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }

  .r3-metric-desc {
    font-size: 0.875rem;
    color: var(--wf-ink);
    line-height: 1.4;
  }

  .r3-partners-wrap {
    border-top: 1px solid var(--wf-line);
    padding-top: var(--wf-space-5);
  }

  .r3-partners-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--wf-space-3);
  }

  .r3-partner-card {
    border: 1px solid var(--wf-line);
    border-radius: var(--wf-radius);
    background-color: var(--wf-fill);
    padding: var(--wf-space-3);
    text-align: center;
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.3;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
  }

  @media (min-width: 768px) {
    .r3-partners-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .r3 {
      padding-block: var(--wf-space-8);
    }

    .r3-title {
      font-size: 2rem;
    }

    .r3-layout {
      display: grid;
      grid-template-columns: 1fr 1.6fr;
      gap: var(--wf-space-7);
      align-items: stretch;
    }

    .r3-visual {
      height: 100%;
      min-height: 400px;
      aspect-ratio: auto;
      order: 0;
    }

    .r3-right {
      order: 0;
    }

    .r3-metric-value {
      font-size: 2.25rem;
    }
  }
</style>
