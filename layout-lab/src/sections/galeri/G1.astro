---
import type { GaleriData } from '../../schema/galeri';

interface Props {
  data: GaleriData;
  id?: string;
}

const { data, id = 'g1' } = Astro.props;
---

<section class="wf-galeri g1" id={id}>
  <div class="wf-container">
    <div class="g1-header">
      <h2 class="g1-title wf-break-word">{data.title}</h2>
      {data.intro && <p class="g1-intro wf-break-word">{data.intro}</p>}
    </div>

    {data.status === 'loading' ? (
      <div class="wf-state-indicator" role="status" aria-live="polite">
        <div class="wf-state-content">
          <span class="wf-state-mark">Memuat</span>
          <span class="wf-state-text">{data.pesanStatus || 'Sedang memuat data galeri...'}</span>
        </div>
      </div>
    ) : data.status === 'error' ? (
      <div class="wf-state-indicator" role="alert" aria-live="assertive">
        <div class="wf-state-content">
          <span class="wf-state-mark">Galat</span>
          <span class="wf-state-text">{data.pesanStatus || 'Gagal memuat galeri. Silakan coba muat ulang.'}</span>
        </div>
        <a href="/uji" class="wf-btn wf-btn-secondary wf-state-action">Muat Ulang</a>
      </div>
    ) : (data.status === 'empty' || !data.items || data.items.length === 0) ? (
      <div class="wf-empty-state">
        <h3 class="wf-empty-title">Belum Ada Item Galeri</h3>
        <p class="wf-empty-desc">{data.pesanStatus || 'Tidak ada entri dokumentasi terdaftar saat ini.'}</p>
        <a href="/uji" class="wf-btn wf-btn-secondary">Pilih Dataset Lain</a>
      </div>
    ) : (
      <div class="g1-grid">
        {data.items.map((item) => (
          <article class="g1-card">
            <div class="wf-visual g1-visual">Visual</div>
            <div class="g1-card-content">
              <h3 class="g1-item-title wf-break-word">{item.title}</h3>
              {item.caption && <p class="g1-item-caption wf-break-word">{item.caption}</p>}
            </div>
          </article>
        ))}
      </div>
    )}
  </div>
</section>

<style>
  .g1 {
    padding-block: var(--wf-space-6);
    border-bottom: 1px solid var(--wf-line);
    background-color: var(--wf-bg);
  }

  .g1-header {
    margin-bottom: var(--wf-space-6);
    max-width: 48rem;
  }

  .g1-title {
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1.25;
    margin-bottom: var(--wf-space-2);
  }

  .g1-intro {
    font-size: 0.9375rem;
    color: var(--wf-ink);
    line-height: 1.6;
  }

  .g1-grid {
    display: flex;
    flex-direction: column;
    gap: var(--wf-space-5);
  }

  .g1-card {
    border: 1px solid var(--wf-line);
    border-radius: var(--wf-radius);
    background-color: var(--wf-bg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .g1-visual {
    width: 100%;
    aspect-ratio: 16 / 10;
    min-height: 160px;
    border: none;
    border-bottom: 1px solid var(--wf-line);
    border-radius: 0;
  }

  .g1-card-content {
    padding: var(--wf-space-4);
    display: flex;
    flex-direction: column;
    gap: var(--wf-space-2);
  }

  .g1-item-title {
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .g1-item-caption {
    font-size: 0.875rem;
    color: var(--wf-ink);
    line-height: 1.5;
  }

  @media (min-width: 768px) {
    .g1-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--wf-space-5);
    }
  }

  @media (min-width: 1024px) {
    .g1 {
      padding-block: var(--wf-space-8);
    }

    .g1-title {
      font-size: 2rem;
    }

    .g1-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--wf-space-6);
    }
  }
</style>
