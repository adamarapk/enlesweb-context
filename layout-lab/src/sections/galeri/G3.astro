---
import type { GaleriData } from '../../schema/galeri';

interface Props {
  data: GaleriData;
  id?: string;
}

const { data, id = 'g3' } = Astro.props;
---

<section class="wf-galeri g3" id={id}>
  <div class="wf-container">
    <div class="g3-header">
      <h2 class="g3-title wf-break-word">{data.title}</h2>
      {data.intro && <p class="g3-intro wf-break-word">{data.intro}</p>}
    </div>

    {data.status === 'loading' ? (
      <div class="wf-state-indicator" role="status" aria-live="polite">
        <div class="wf-state-content">
          <span class="wf-state-mark">Memuat</span>
          <span class="wf-state-text">{data.pesanStatus || 'Sedang memuat data perbandingan visual...'}</span>
        </div>
      </div>
    ) : data.status === 'error' ? (
      <div class="wf-state-indicator" role="alert" aria-live="assertive">
        <div class="wf-state-content">
          <span class="wf-state-mark">Galat</span>
          <span class="wf-state-text">{data.pesanStatus || 'Gagal memuat perbandingan visual. Silakan coba muat ulang.'}</span>
        </div>
        <a href="/uji" class="wf-btn wf-btn-secondary wf-state-action">Muat Ulang</a>
      </div>
    ) : (data.status === 'empty' || !data.items || data.items.length === 0) ? (
      <div class="wf-empty-state">
        <h3 class="wf-empty-title">Belum Ada Item Perbandingan</h3>
        <p class="wf-empty-desc">{data.pesanStatus || 'Tidak ada entri perbandingan terdaftar saat ini.'}</p>
        <a href="/uji" class="wf-btn wf-btn-secondary">Pilih Dataset Lain</a>
      </div>
    ) : (
      <div class="g3-grid">
        {data.items.map((item) => (
          <article class="g3-card">
            <div class="g3-visual-pair">
              <div class="wf-visual g3-visual-box">{item.comparisonTitle ? 'Visual A' : 'Visual'}</div>
              <div class="wf-visual g3-visual-box">{item.comparisonTitle ? 'Visual B' : 'Visual'}</div>
            </div>
            <div class="g3-card-content">
              <h3 class="g3-item-title wf-break-word">{item.title}</h3>
              {item.comparisonTitle && (
                <p class="g3-comparison-note wf-break-word">{item.comparisonTitle}</p>
              )}
              {item.caption && (
                <p class="g3-item-caption wf-break-word">{item.caption}</p>
              )}
            </div>
          </article>
        ))}
      </div>
    )}
  </div>
</section>

<style>
  .g3 {
    padding-block: var(--wf-space-6);
    border-bottom: 1px solid var(--wf-line);
    background-color: var(--wf-bg);
  }

  .g3-header {
    margin-bottom: var(--wf-space-6);
    max-width: 48rem;
  }

  .g3-title {
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1.25;
    margin-bottom: var(--wf-space-2);
  }

  .g3-intro {
    font-size: 0.9375rem;
    color: var(--wf-ink);
    line-height: 1.6;
  }

  .g3-grid {
    display: flex;
    flex-direction: column;
    gap: var(--wf-space-5);
  }

  .g3-card {
    border: 1px solid var(--wf-line);
    border-radius: var(--wf-radius);
    background-color: var(--wf-bg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .g3-visual-pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background-color: var(--wf-line);
    border-bottom: 1px solid var(--wf-line);
  }

  .g3-visual-box {
    width: 100%;
    aspect-ratio: 4 / 3;
    min-height: 140px;
    border: none;
    border-radius: 0;
  }

  .g3-card-content {
    padding: var(--wf-space-4);
    display: flex;
    flex-direction: column;
    gap: var(--wf-space-2);
  }

  .g3-item-title {
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .g3-comparison-note {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--wf-ink);
    opacity: 0.85;
    line-height: 1.4;
  }

  .g3-item-caption {
    font-size: 0.875rem;
    color: var(--wf-ink);
    line-height: 1.5;
  }

  @media (min-width: 768px) {
    .g3-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--wf-space-5);
    }
  }

  @media (min-width: 1024px) {
    .g3 {
      padding-block: var(--wf-space-8);
    }

    .g3-title {
      font-size: 2rem;
    }

    .g3-grid {
      gap: var(--wf-space-6);
    }
  }
</style>
