---
import type { CtaData } from '../../schema/cta';

interface Props {
  data: CtaData;
  id?: string;
}

const { data, id = 'c3' } = Astro.props;
const hasContacts = data.contacts && data.contacts.length > 0;
---

<section class="wf-cta c3" id={id}>
  <div class="wf-container">
    {data.status === 'loading' ? (
      <div class="wf-state-indicator" role="status" aria-live="polite">
        <div class="wf-state-content">
          <span class="wf-state-mark">Memuat</span>
          <span class="wf-state-text">{data.pesanStatus || 'Sedang memuat modul tindakan konversi...'}</span>
        </div>
      </div>
    ) : data.status === 'error' ? (
      <div class="wf-state-indicator" role="alert" aria-live="assertive">
        <div class="wf-state-content">
          <span class="wf-state-mark">Galat</span>
          <span class="wf-state-text">{data.pesanStatus || 'Gagal memuat modul tindakan. Silakan coba muat ulang.'}</span>
        </div>
        <a href="/uji?mode=status" class="wf-btn wf-btn-secondary wf-state-action">Muat Ulang</a>
      </div>
    ) : (data.status === 'empty' || (!data.ctaLabel && !data.text && !hasContacts)) ? (
      <div class="wf-empty-state">
        <h3 class="wf-empty-title">Aksi Belum Dikonfigurasi</h3>
        <p class="wf-empty-desc">{data.pesanStatus || 'Belum ada data aksi tindakan konversi dalam konfigurasi saat ini.'}</p>
        <a href="/uji" class="wf-btn wf-btn-secondary">Pilih Dataset Lain</a>
      </div>
    ) : (
      <div class={`c3-card ${!hasContacts ? 'c3-card-solo' : ''}`}>
        <div class="c3-main-col">
          <h2 class="c3-title wf-break-word">{data.title}</h2>
          {data.text && <p class="c3-text wf-break-word">{data.text}</p>}

          {data.ctaLabel && (
            <div class="c3-action">
              <a href={data.ctaUrl || '/galeri'} class="wf-btn wf-btn-primary">
                {data.ctaLabel}
              </a>
            </div>
          )}
        </div>

        {hasContacts && (
          <div class="c3-contact-col">
            <h3 class="c3-contact-header">Informasi Kontak</h3>
            <div class="c3-contact-list">
              {data.contacts!.map((c) => (
                <div class="c3-contact-item">
                  <span class="c3-contact-label wf-break-word">{c.label}</span>
                  <span class="c3-contact-value wf-break-word">{c.value}</span>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>
    )}
  </div>
</section>

<style>
  .c3 {
    padding-block: var(--wf-space-6);
    border-bottom: 1px solid var(--wf-line);
    background-color: var(--wf-bg);
  }

  .c3-card {
    border: 2px solid var(--wf-line);
    border-radius: var(--wf-radius);
    padding: var(--wf-space-5);
    background-color: var(--wf-bg);
    display: flex;
    flex-direction: column;
    gap: var(--wf-space-6);
  }

  .c3-main-col {
    display: flex;
    flex-direction: column;
    gap: var(--wf-space-4);
  }

  .c3-title {
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .c3-text {
    font-size: 0.9375rem;
    color: var(--wf-ink);
    line-height: 1.6;
    max-width: 40rem;
  }

  .c3-action {
    padding-top: var(--wf-space-2);
  }

  .c3-action .wf-btn {
    min-width: 160px;
    text-align: center;
  }

  .c3-contact-col {
    border-top: 1px solid var(--wf-line);
    padding-top: var(--wf-space-4);
    display: flex;
    flex-direction: column;
    gap: var(--wf-space-3);
  }

  .c3-contact-header {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--wf-ink);
    border-bottom: 1px solid var(--wf-line);
    padding-bottom: var(--wf-space-1);
  }

  .c3-contact-list {
    display: flex;
    flex-direction: column;
    gap: var(--wf-space-2);
  }

  .c3-contact-item {
    display: flex;
    flex-direction: column;
    gap: var(--wf-space-1);
    font-size: 0.875rem;
    padding-bottom: var(--wf-space-1);
    border-bottom: 1px dashed var(--wf-line);
  }

  .c3-contact-item:last-child {
    border-bottom: none;
  }

  .c3-contact-label {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.75rem;
    color: var(--wf-line);
    font-weight: 600;
  }

  .c3-contact-value {
    color: var(--wf-ink);
    font-weight: 600;
  }

  /* 768px tablet layout: 2-column contact grid */
  @media (min-width: 768px) and (max-width: 1023px) {
    .c3-contact-list {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--wf-space-3);
    }
  }

  /* 1280px / >=1024px desktop layout: kartu terbungkus dengan [Judul/teks/tombol] dan kontak */
  @media (min-width: 1024px) {
    .c3 {
      padding-block: var(--wf-space-8);
    }

    .c3-title {
      font-size: 2rem;
    }

    .c3-card {
      display: grid;
      grid-template-columns: 7fr 5fr;
      gap: var(--wf-space-7);
      padding: var(--wf-space-7);
      align-items: start;
    }

    .c3-card-solo {
      display: block;
      max-width: 52rem;
      margin-inline: auto;
    }

    .c3-contact-col {
      border-top: none;
      border-left: 1px solid var(--wf-line);
      padding-top: 0;
      padding-left: var(--wf-space-6);
    }
  }
</style>
