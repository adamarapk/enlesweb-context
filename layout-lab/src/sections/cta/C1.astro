---
import type { CtaData } from '../../schema/cta';

interface Props {
  data: CtaData;
  id?: string;
}

const { data, id = 'c1' } = Astro.props;
---

<section class="wf-cta c1" id={id}>
  <div class="wf-container">
    {data.status === 'loading' ? (
      <div class="wf-state-indicator" role="status" aria-live="polite">
        <div class="wf-state-content">
          <span class="wf-state-mark">Memuat</span>
          <span class="wf-state-text">{data.pesanStatus || 'Sedang memuat modul tindakan konversi...'}</span>
        </div>
      </div>
    ) : data.status === 'error' ? (
      <div class="wf-state-indicator" role="alert" aria-live="assertive">
        <div class="wf-state-content">
          <span class="wf-state-mark">Galat</span>
          <span class="wf-state-text">{data.pesanStatus || 'Gagal memuat modul tindakan. Silakan coba muat ulang.'}</span>
        </div>
        <a href="/uji?mode=status" class="wf-btn wf-btn-secondary wf-state-action">Muat Ulang</a>
      </div>
    ) : (data.status === 'empty' || (!data.ctaLabel && !data.text)) ? (
      <div class="wf-empty-state">
        <h3 class="wf-empty-title">Aksi Belum Dikonfigurasi</h3>
        <p class="wf-empty-desc">{data.pesanStatus || 'Belum ada data aksi tindakan konversi dalam konfigurasi saat ini.'}</p>
        <a href="/uji" class="wf-btn wf-btn-secondary">Pilih Dataset Lain</a>
      </div>
    ) : (
      <div class="c1-banner">
        <div class="c1-text-wrap">
          <h2 class="c1-title wf-break-word">{data.title}</h2>
          {data.text && <p class="c1-text wf-break-word">{data.text}</p>}
        </div>

        {data.ctaLabel && (
          <div class="c1-action-wrap">
            <a href={data.ctaUrl || '/galeri'} class="wf-btn wf-btn-primary">
              {data.ctaLabel}
            </a>
          </div>
        )}
      </div>
    )}
  </div>
</section>

<style>
  .c1 {
    padding-block: var(--wf-space-6);
    border-bottom: 1px solid var(--wf-line);
    background-color: var(--wf-bg);
  }

  .c1-banner {
    border: 1px solid var(--wf-line);
    border-radius: var(--wf-radius);
    padding: var(--wf-space-5);
    background-color: var(--wf-fill);
    display: flex;
    flex-direction: column;
    gap: var(--wf-space-4);
  }

  .c1-text-wrap {
    display: flex;
    flex-direction: column;
    gap: var(--wf-space-2);
  }

  .c1-title {
    font-size: 1.25rem;
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .c1-text {
    font-size: 0.9375rem;
    color: var(--wf-ink);
    line-height: 1.5;
  }

  .c1-action-wrap {
    display: flex;
    align-items: center;
  }

  .c1-action-wrap .wf-btn {
    width: 100%;
  }

  /* 768px tablet layout: banner horizontal satu baris */
  @media (min-width: 768px) {
    .c1-banner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--wf-space-5);
      padding: var(--wf-space-5) var(--wf-space-6);
    }

    .c1-text-wrap {
      max-width: 36rem;
      min-width: 0;
    }

    .c1-action-wrap {
      flex-shrink: 0;
    }

    .c1-action-wrap .wf-btn {
      width: auto;
      white-space: nowrap;
    }
  }

  /* 1280px / >=1024px desktop layout: banner satu baris [Teks] | [Tombol] */
  @media (min-width: 1024px) {
    .c1 {
      padding-block: var(--wf-space-7);
    }

    .c1-banner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--wf-space-6);
      padding: var(--wf-space-6) var(--wf-space-7);
    }

    .c1-text-wrap {
      max-width: 48rem;
      min-width: 0;
    }

    .c1-title {
      font-size: 1.5rem;
    }

    .c1-action-wrap {
      flex-shrink: 0;
    }

    .c1-action-wrap .wf-btn {
      width: auto;
      white-space: nowrap;
    }
  }
</style>
