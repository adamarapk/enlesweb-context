---
import type { NavbarData } from '../../schema/navbar';

interface Props {
  data: NavbarData;
  id?: string;
}

const { data, id = 'n1' } = Astro.props;
const menuId = `${id}-panel`;
---

<header class="wf-navbar n1" id={id}>
  <div class="wf-container n1-inner">
    <div class="n1-brand">
      <a href={data.brand.href || "#section-navbar"} class="n1-brand-link">
        <span class="n1-brand-name">{data.brand.nama}</span>
        {data.brand.subjudul && <span class="n1-brand-sub">{data.brand.subjudul}</span>}
      </a>
    </div>

    <button
      type="button"
      class="wf-btn n1-toggle"
      data-menu-toggle
      aria-expanded="false"
      aria-controls={menuId}
      aria-label="Buka menu navigasi"
    >
      Menu
    </button>

    <div class="n1-nav-wrap" id={menuId}>
      <nav class="n1-menu" aria-label="Navigasi Utama N1">
        <ul class="n1-list">
          {data.menu.map((item) => (
            <li class="n1-item">
              <a href={item.href} class="n1-link">{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="n1-cta-wrap">
        <a href={data.cta.href} class="wf-btn wf-btn-primary n1-cta">{data.cta.label}</a>
      </div>
    </div>
  </div>
</header>

<style>
  .n1 {
    background-color: var(--wf-bg);
    border-bottom: 1px solid var(--wf-line);
    width: 100%;
  }

  .n1-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    min-height: 64px;
    padding-block: var(--wf-space-2);
  }

  .n1-brand-link {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 44px;
    color: var(--wf-ink);
  }

  .n1-brand-name {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .n1-brand-sub {
    font-size: 0.6875rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    color: var(--wf-line);
  }

  .n1-toggle {
    display: inline-flex;
    padding: var(--wf-space-2) var(--wf-space-3);
  }

  .n1-nav-wrap {
    display: none;
    width: 100%;
    padding-top: var(--wf-space-3);
    margin-top: var(--wf-space-2);
    border-top: 1px solid var(--wf-line);
  }

  @media (max-width: 1023px) {
    .n1-nav-wrap.is-open {
      display: flex;
      flex-direction: column;
      gap: var(--wf-space-3);
    }
  }

  .n1-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--wf-space-2);
  }

  .n1-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: var(--wf-space-1) 0;
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--wf-ink);
    text-decoration: none;
  }

  .n1-link:hover {
    text-decoration: underline;
  }

  .n1-cta-wrap {
    padding-top: var(--wf-space-2);
  }

  .n1-cta {
    width: 100%;
    text-align: center;
  }

  /* 1280px / >=1024px desktop layout: [Brand] | [Menu] | [CTA] */
  @media (min-width: 1024px) {
    .n1-inner {
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: var(--wf-space-5);
      flex-wrap: nowrap;
    }

    .n1-toggle {
      display: none;
    }

    .n1-nav-wrap {
      display: contents;
      padding-top: 0;
      margin-top: 0;
      border-top: none;
    }

    .n1-menu {
      justify-self: center;
    }

    .n1-list {
      flex-direction: row;
      align-items: center;
      gap: var(--wf-space-5);
    }

    .n1-link {
      padding: var(--wf-space-2) var(--wf-space-1);
    }

    .n1-cta-wrap {
      justify-self: end;
      padding-top: 0;
    }

    .n1-cta {
      width: auto;
    }
  }
</style>
