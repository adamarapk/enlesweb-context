---
import type { NavbarData } from '../../schema/navbar';

interface Props {
  data: NavbarData;
  id?: string;
}

const { data, id = 'n3' } = Astro.props;
const menuId = `${id}-panel`;

const midIndex = Math.ceil(data.menu.length / 2);
const menuLeft = data.menu.slice(0, midIndex);
const menuRight = data.menu.slice(midIndex);
---

<header class="wf-navbar n3" id={id}>
  <div class="wf-container n3-inner">
    <nav class="n3-desktop-left" aria-label="Navigasi Kiri N3">
      <ul class="n3-list">
        {menuLeft.map((item) => (
          <li>
            <a href={item.href} class="n3-link">{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="n3-brand">
      <a href={data.brand.href || "#section-navbar"} class="n3-brand-link">
        <span class="n3-brand-name">{data.brand.nama}</span>
        {data.brand.subjudul && <span class="n3-brand-sub">{data.brand.subjudul}</span>}
      </a>
    </div>

    <button
      type="button"
      class="wf-btn n3-toggle"
      data-menu-toggle
      aria-expanded="false"
      aria-controls={menuId}
      aria-label="Buka menu navigasi"
    >
      Menu
    </button>

    <div class="n3-desktop-right">
      <nav class="n3-right-nav" aria-label="Navigasi Kanan N3">
        <ul class="n3-list">
          {menuRight.map((item) => (
            <li>
              <a href={item.href} class="n3-link">{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
      <a href={data.cta.href} class="wf-btn wf-btn-primary n3-cta">{data.cta.label}</a>
    </div>

    <div class="n3-mobile-panel" id={menuId}>
      <nav aria-label="Navigasi Mobile N3">
        <ul class="n3-mobile-list">
          {data.menu.map((item) => (
            <li>
              <a href={item.href} class="n3-link">{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
      <div class="n3-mobile-cta">
        <a href={data.cta.href} class="wf-btn wf-btn-primary n3-cta-btn">{data.cta.label}</a>
      </div>
    </div>
  </div>
</header>

<style>
  .n3 {
    background-color: var(--wf-bg);
    border-bottom: 1px solid var(--wf-line);
    width: 100%;
  }

  .n3-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    min-height: 64px;
    padding-block: var(--wf-space-2);
  }

  .n3-brand-link {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 44px;
    color: var(--wf-ink);
  }

  .n3-brand-name {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .n3-brand-sub {
    font-size: 0.6875rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    color: var(--wf-line);
  }

  .n3-desktop-left,
  .n3-desktop-right {
    display: none;
  }

  .n3-toggle {
    display: inline-flex;
    padding: var(--wf-space-2) var(--wf-space-3);
  }

  .n3-mobile-panel {
    display: none;
    width: 100%;
    padding-top: var(--wf-space-3);
    margin-top: var(--wf-space-2);
    border-top: 1px solid var(--wf-line);
  }

  @media (max-width: 1023px) {
    .n3-mobile-panel.is-open {
      display: flex;
      flex-direction: column;
      gap: var(--wf-space-3);
    }
  }

  .n3-mobile-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--wf-space-2);
  }

  .n3-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: var(--wf-space-1) 0;
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--wf-ink);
    text-decoration: none;
  }

  .n3-link:hover {
    text-decoration: underline;
  }

  .n3-mobile-cta {
    padding-top: var(--wf-space-2);
  }

  .n3-cta-btn {
    width: 100%;
    text-align: center;
  }

  /* 1280px / >=1024px desktop layout: [Menu kiri] | [Brand tengah] | [Menu kanan+CTA] */
  @media (min-width: 1024px) {
    .n3-inner {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: var(--wf-space-4);
      flex-wrap: nowrap;
    }

    .n3-toggle,
    .n3-mobile-panel {
      display: none !important;
    }

    .n3-desktop-left {
      display: flex;
      align-items: center;
    }

    .n3-brand {
      justify-self: center;
      text-align: center;
    }

    .n3-brand-link {
      align-items: center;
    }

    .n3-desktop-right {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: var(--wf-space-4);
    }

    .n3-list {
      list-style: none;
      display: flex;
      align-items: center;
      gap: var(--wf-space-4);
    }

    .n3-link {
      padding: var(--wf-space-2) var(--wf-space-1);
    }
  }
</style>
