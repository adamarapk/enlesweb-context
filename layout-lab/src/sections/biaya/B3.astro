---
import type { BiayaData } from '../../schema/biaya';

interface Props {
  data: BiayaData;
  id?: string;
}

const { data, id = 'b3' } = Astro.props;
---

<section class="wf-biaya b3" id={id}>
  <div class="wf-container">
    <div class="b3-header">
      <h2 class="b3-title wf-break-word">{data.title}</h2>
      {data.intro && <p class="b3-intro wf-break-word">{data.intro}</p>}
    </div>

    {data.status === 'loading' ? (
      <div class="wf-state-indicator" role="status" aria-live="polite">
        <div class="wf-state-content">
          <span class="wf-state-mark">Memuat</span>
          <span class="wf-state-text">{data.pesanStatus || 'Sedang memuat data biaya...'}</span>
        </div>
      </div>
    ) : data.status === 'error' ? (
      <div class="wf-state-indicator" role="alert" aria-live="assertive">
        <div class="wf-state-content">
          <span class="wf-state-mark">Galat</span>
          <span class="wf-state-text">{data.pesanStatus || 'Gagal memuat paket biaya. Silakan coba muat ulang.'}</span>
        </div>
        <a href="/uji" class="wf-btn wf-btn-secondary wf-state-action">Muat Ulang</a>
      </div>
    ) : (data.status === 'empty' || !data.items || data.items.length === 0) ? (
      <div class="wf-empty-state">
        <h3 class="wf-empty-title">Belum Ada Paket Biaya</h3>
        <p class="wf-empty-desc">{data.pesanStatus || 'Tidak ada entri paket biaya terdaftar saat ini.'}</p>
        <a href="/uji" class="wf-btn wf-btn-secondary">Pilih Dataset Lain</a>
      </div>
    ) : (
      <div class="b3-list">
        {data.items.map((item) => (
          <article class="b3-item">
            <div class="b3-left">
              <h3 class="b3-item-title wf-break-word">{item.title}</h3>
              <div class="b3-price-wrap">
                <span class="b3-price">{item.price}</span>
                {item.unit && <span class="b3-unit">{item.unit}</span>}
              </div>
              {item.description && (
                <p class="b3-desc wf-break-word">{item.description}</p>
              )}
              <div class="b3-action">
                <a href={item.ctaHref || "#section-cta"} class="wf-btn wf-btn-primary b3-btn">{item.ctaText}</a>
              </div>
            </div>

            <div class="b3-right">
              {item.features && item.features.length > 0 && (
                <ul class="b3-features-grid">
                  {item.features.map((feature) => (
                    <li class="b3-feature-item wf-break-word">{feature}</li>
                  ))}
                </ul>
              )}
            </div>
          </article>
        ))}
      </div>
    )}
  </div>
</section>

<style>
  .b3 {
    padding-block: var(--wf-space-6);
    border-bottom: 1px solid var(--wf-line);
    background-color: var(--wf-bg);
  }

  .b3-header {
    margin-bottom: var(--wf-space-6);
    max-width: 48rem;
  }

  .b3-title {
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1.25;
    margin-bottom: var(--wf-space-2);
  }

  .b3-intro {
    font-size: 0.9375rem;
    color: var(--wf-ink);
    line-height: 1.6;
  }

  .b3-list {
    border-top: 1px solid var(--wf-line);
  }

  .b3-item {
    border-bottom: 1px solid var(--wf-line);
    padding-block: var(--wf-space-6);
    display: flex;
    flex-direction: column;
    gap: var(--wf-space-5);
  }

  .b3-left {
    display: flex;
    flex-direction: column;
    gap: var(--wf-space-3);
  }

  .b3-item-title {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .b3-price-wrap {
    display: flex;
    align-items: baseline;
    gap: var(--wf-space-1);
  }

  .b3-price {
    font-size: 1.625rem;
    font-weight: 800;
    line-height: 1.2;
  }

  .b3-unit {
    font-size: 0.875rem;
    color: var(--wf-ink);
    opacity: 0.85;
  }

  .b3-desc {
    font-size: 0.875rem;
    color: var(--wf-ink);
    line-height: 1.5;
    max-width: 32rem;
  }

  .b3-action {
    padding-top: var(--wf-space-2);
  }

  .b3-btn {
    width: 100%;
  }

  .b3-right {
    display: flex;
    flex-direction: column;
  }

  .b3-features-grid {
    list-style: square;
    padding-left: var(--wf-space-4);
    display: flex;
    flex-direction: column;
    gap: var(--wf-space-2);
  }

  .b3-feature-item {
    font-size: 0.875rem;
    line-height: 1.4;
  }

  @media (min-width: 768px) {
    .b3-btn {
      width: auto;
      min-width: 180px;
    }

    .b3-features-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--wf-space-3) var(--wf-space-5);
    }
  }

  @media (min-width: 1024px) {
    .b3 {
      padding-block: var(--wf-space-8);
    }

    .b3-title {
      font-size: 2rem;
    }

    .b3-item {
      display: grid;
      grid-template-columns: 1fr 1.3fr;
      gap: var(--wf-space-7);
      align-items: start;
      padding-block: var(--wf-space-7);
    }
  }
</style>
