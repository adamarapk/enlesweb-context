---
import type { BiayaData } from '../../schema/biaya';

interface Props {
  data: BiayaData;
  id?: string;
}

const { data, id = 'b2' } = Astro.props;
---

<section class="wf-biaya b2" id={id}>
  <div class="wf-container">
    <div class="b2-header">
      <h2 class="b2-title wf-break-word">{data.title}</h2>
      {data.intro && <p class="b2-intro wf-break-word">{data.intro}</p>}
    </div>

    {data.status === 'loading' ? (
      <div class="wf-state-indicator" role="status" aria-live="polite">
        <div class="wf-state-content">
          <span class="wf-state-mark">Memuat</span>
          <span class="wf-state-text">{data.pesanStatus || 'Sedang memuat data biaya...'}</span>
        </div>
      </div>
    ) : data.status === 'error' ? (
      <div class="wf-state-indicator" role="alert" aria-live="assertive">
        <div class="wf-state-content">
          <span class="wf-state-mark">Galat</span>
          <span class="wf-state-text">{data.pesanStatus || 'Gagal memuat paket biaya. Silakan coba muat ulang.'}</span>
        </div>
        <a href="/uji" class="wf-btn wf-btn-secondary wf-state-action">Muat Ulang</a>
      </div>
    ) : (data.status === 'empty' || !data.items || data.items.length === 0) ? (
      <div class="wf-empty-state">
        <h3 class="wf-empty-title">Belum Ada Paket Biaya</h3>
        <p class="wf-empty-desc">{data.pesanStatus || 'Tidak ada entri paket biaya terdaftar saat ini.'}</p>
        <a href="/uji" class="wf-btn wf-btn-secondary">Pilih Dataset Lain</a>
      </div>
    ) : (
      <div class="b2-list">
        {data.items.map((item) => (
          <article class="b2-row">
            <div class="b2-col-info">
              <h3 class="b2-title-item wf-break-word">{item.title}</h3>
              {item.description && (
                <p class="b2-desc wf-break-word">{item.description}</p>
              )}
            </div>

            <div class="b2-col-features">
              {item.features && item.features.length > 0 && (
                <ul class="b2-features">
                  {item.features.map((feature) => (
                    <li class="b2-feature-item wf-break-word">{feature}</li>
                  ))}
                </ul>
              )}
            </div>

            <div class="b2-col-action">
              <div class="b2-price-wrap">
                <span class="b2-price">{item.price}</span>
                {item.unit && <span class="b2-unit">{item.unit}</span>}
              </div>
              <a href={item.ctaHref || "#section-cta"} class="wf-btn wf-btn-primary b2-btn">{item.ctaText}</a>
            </div>
          </article>
        ))}
      </div>
    )}
  </div>
</section>

<style>
  .b2 {
    padding-block: var(--wf-space-6);
    border-bottom: 1px solid var(--wf-line);
    background-color: var(--wf-bg);
  }

  .b2-header {
    margin-bottom: var(--wf-space-6);
    max-width: 48rem;
  }

  .b2-title {
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1.25;
    margin-bottom: var(--wf-space-2);
  }

  .b2-intro {
    font-size: 0.9375rem;
    color: var(--wf-ink);
    line-height: 1.6;
  }

  .b2-list {
    display: flex;
    flex-direction: column;
    gap: var(--wf-space-4);
  }

  .b2-row {
    border: 1px solid var(--wf-line);
    border-radius: var(--wf-radius);
    padding: var(--wf-space-5);
    background-color: var(--wf-bg);
    display: flex;
    flex-direction: column;
    gap: var(--wf-space-4);
  }

  .b2-col-info {
    display: flex;
    flex-direction: column;
    gap: var(--wf-space-2);
  }

  .b2-title-item {
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .b2-desc {
    font-size: 0.875rem;
    color: var(--wf-ink);
    line-height: 1.5;
  }

  .b2-col-features {
    border-top: 1px solid var(--wf-line);
    padding-top: var(--wf-space-3);
  }

  .b2-features {
    list-style: square;
    padding-left: var(--wf-space-4);
    display: flex;
    flex-direction: column;
    gap: var(--wf-space-2);
  }

  .b2-feature-item {
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .b2-col-action {
    border-top: 1px solid var(--wf-line);
    padding-top: var(--wf-space-3);
    display: flex;
    flex-direction: column;
    gap: var(--wf-space-3);
  }

  .b2-price-wrap {
    display: flex;
    align-items: baseline;
    gap: var(--wf-space-1);
  }

  .b2-price {
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1.2;
  }

  .b2-unit {
    font-size: 0.875rem;
    color: var(--wf-ink);
    opacity: 0.85;
  }

  .b2-btn {
    width: 100%;
  }

  @media (min-width: 1024px) {
    .b2 {
      padding-block: var(--wf-space-8);
    }

    .b2-title {
      font-size: 2rem;
    }

    .b2-row {
      display: grid;
      grid-template-columns: 1.2fr 1.4fr 1fr;
      gap: var(--wf-space-6);
      align-items: center;
      padding: var(--wf-space-5) var(--wf-space-6);
    }

    .b2-col-features {
      border-top: none;
      border-inline: 1px solid var(--wf-line);
      padding-top: 0;
      padding-inline: var(--wf-space-5);
    }

    .b2-col-action {
      border-top: none;
      padding-top: 0;
      align-items: flex-end;
      text-align: right;
    }

    .b2-btn {
      width: auto;
      min-width: 160px;
    }
  }
</style>
