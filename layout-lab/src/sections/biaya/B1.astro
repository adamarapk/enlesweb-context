---
import type { BiayaData } from '../../schema/biaya';

interface Props {
  data: BiayaData;
  id?: string;
}

const { data, id = 'b1' } = Astro.props;
---

<section class="wf-biaya b1" id={id}>
  <div class="wf-container">
    <div class="b1-header">
      <h2 class="b1-title wf-break-word">{data.title}</h2>
      {data.intro && <p class="b1-intro wf-break-word">{data.intro}</p>}
    </div>

    {data.status === 'loading' ? (
      <div class="wf-state-indicator" role="status" aria-live="polite">
        <div class="wf-state-content">
          <span class="wf-state-mark">Memuat</span>
          <span class="wf-state-text">{data.pesanStatus || 'Sedang memuat data biaya...'}</span>
        </div>
      </div>
    ) : data.status === 'error' ? (
      <div class="wf-state-indicator" role="alert" aria-live="assertive">
        <div class="wf-state-content">
          <span class="wf-state-mark">Galat</span>
          <span class="wf-state-text">{data.pesanStatus || 'Gagal memuat paket biaya. Silakan coba muat ulang.'}</span>
        </div>
        <a href="/uji" class="wf-btn wf-btn-secondary wf-state-action">Muat Ulang</a>
      </div>
    ) : (data.status === 'empty' || !data.items || data.items.length === 0) ? (
      <div class="wf-empty-state">
        <h3 class="wf-empty-title">Belum Ada Paket Biaya</h3>
        <p class="wf-empty-desc">{data.pesanStatus || 'Tidak ada entri paket biaya terdaftar saat ini.'}</p>
        <a href="/uji" class="wf-btn wf-btn-secondary">Pilih Dataset Lain</a>
      </div>
    ) : (
      <div class="b1-grid">
        {data.items.map((item) => (
          <article class="b1-card">
            <div class="b1-card-top">
              <h3 class="b1-item-title wf-break-word">{item.title}</h3>
              <div class="b1-price-wrap">
                <span class="b1-price">{item.price}</span>
                {item.unit && <span class="b1-unit">{item.unit}</span>}
              </div>
              {item.description && (
                <p class="b1-desc wf-break-word">{item.description}</p>
              )}
            </div>

            {item.features && item.features.length > 0 && (
              <ul class="b1-features">
                {item.features.map((feature) => (
                  <li class="b1-feature-item wf-break-word">{feature}</li>
                ))}
              </ul>
            )}

            <div class="b1-action">
              <a href={item.ctaHref || "#section-cta"} class="wf-btn wf-btn-primary b1-btn">{item.ctaText}</a>
            </div>
          </article>
        ))}
      </div>
    )}
  </div>
</section>

<style>
  .b1 {
    padding-block: var(--wf-space-6);
    border-bottom: 1px solid var(--wf-line);
    background-color: var(--wf-bg);
  }

  .b1-header {
    margin-bottom: var(--wf-space-6);
    max-width: 48rem;
  }

  .b1-title {
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1.25;
    margin-bottom: var(--wf-space-2);
  }

  .b1-intro {
    font-size: 0.9375rem;
    color: var(--wf-ink);
    line-height: 1.6;
  }

  .b1-grid {
    display: flex;
    flex-direction: column;
    gap: var(--wf-space-5);
  }

  .b1-card {
    border: 1px solid var(--wf-line);
    border-radius: var(--wf-radius);
    padding: var(--wf-space-5);
    background-color: var(--wf-bg);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--wf-space-4);
  }

  .b1-card-top {
    display: flex;
    flex-direction: column;
    gap: var(--wf-space-2);
  }

  .b1-item-title {
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .b1-price-wrap {
    display: flex;
    align-items: baseline;
    gap: var(--wf-space-1);
    margin-block: var(--wf-space-1);
  }

  .b1-price {
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1.2;
  }

  .b1-unit {
    font-size: 0.875rem;
    color: var(--wf-ink);
    opacity: 0.85;
  }

  .b1-desc {
    font-size: 0.875rem;
    color: var(--wf-ink);
    line-height: 1.5;
  }

  .b1-features {
    list-style: square;
    padding-left: var(--wf-space-4);
    display: flex;
    flex-direction: column;
    gap: var(--wf-space-2);
    margin-block: var(--wf-space-2);
    border-top: 1px solid var(--wf-line);
    padding-top: var(--wf-space-3);
  }

  .b1-feature-item {
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .b1-action {
    margin-top: auto;
    padding-top: var(--wf-space-2);
  }

  .b1-btn {
    width: 100%;
  }

  @media (min-width: 768px) {
    .b1-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--wf-space-5);
    }
  }

  @media (min-width: 1024px) {
    .b1 {
      padding-block: var(--wf-space-8);
    }

    .b1-title {
      font-size: 2rem;
    }

    .b1-grid {
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: var(--wf-space-6);
    }
  }
</style>
