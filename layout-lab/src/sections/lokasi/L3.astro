---
import type { LokasiData } from '../../schema/lokasi';

interface Props {
  data: LokasiData;
  id?: string;
}

const { data, id = 'l3' } = Astro.props;
const isExternalMap = data.mapsUrl ? (data.mapsUrl.startsWith('http://') || data.mapsUrl.startsWith('https://')) : false;
---

<section class="wf-lokasi l3" id={id}>
  <div class="wf-container">
    <div class="l3-header">
      <h2 class="l3-title wf-break-word">{data.title}</h2>
    </div>

    {data.status === 'loading' ? (
      <div class="wf-state-indicator" role="status" aria-live="polite">
        <div class="wf-state-content">
          <span class="wf-state-mark">Memuat</span>
          <span class="wf-state-text">{data.pesanStatus || 'Sedang memuat data lokasi dan jadwal operasional...'}</span>
        </div>
      </div>
    ) : data.status === 'error' ? (
      <div class="wf-state-indicator" role="alert" aria-live="assertive">
        <div class="wf-state-content">
          <span class="wf-state-mark">Galat</span>
          <span class="wf-state-text">{data.pesanStatus || 'Gagal memuat data lokasi dan jadwal. Silakan coba muat ulang.'}</span>
        </div>
        <a href="/uji?mode=status" class="wf-btn wf-btn-secondary wf-state-action">Muat Ulang</a>
      </div>
    ) : (data.status === 'empty' || (!data.address && (!data.openingHours || data.openingHours.length === 0))) ? (
      <div class="wf-empty-state">
        <h3 class="wf-empty-title">Informasi Lokasi Belum Tersedia</h3>
        <p class="wf-empty-desc">{data.pesanStatus || 'Detail alamat dan jam operasional belum dikonfigurasi dalam sistem.'}</p>
        <a href="/uji" class="wf-btn wf-btn-secondary">Pilih Dataset Lain</a>
      </div>
    ) : (
      <div class="l3-card">
        {data.address && (
          <div class="l3-section-block">
            <h3 class="l3-block-title">Alamat Operasional</h3>
            <p class="l3-address-text wf-break-word">{data.address}</p>
            {data.city && <p class="l3-city-text wf-break-word">{data.city}</p>}
            {data.landmarkNote && (
              <p class="l3-landmark-text wf-break-word">{data.landmarkNote}</p>
            )}
          </div>
        )}

        {data.openingHours && data.openingHours.length > 0 && (
          <div class="l3-section-block">
            <h3 class="l3-block-title">Jadwal Operasional</h3>
            <div class="l3-hours-list">
              {data.openingHours.map((row) => (
                <div class="l3-hours-row">
                  <span class="l3-hours-days wf-break-word">{row.days}</span>
                  <span class="l3-hours-time wf-break-word">{row.hours}</span>
                </div>
              ))}
            </div>
          </div>
        )}

        <div class="l3-actions">
          <a
            href={data.mapsUrl || '#section-lokasi'}
            target={isExternalMap ? '_blank' : undefined}
            rel={isExternalMap ? 'noopener noreferrer' : undefined}
            class="wf-btn wf-btn-primary"
            aria-label={isExternalMap ? 'Buka lokasi di Google Maps (terbuka di tab baru)' : 'Lokasi kantor'}
          >
            Buka di Maps
          </a>
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .l3 {
    padding-block: var(--wf-space-6);
    border-bottom: 1px solid var(--wf-line);
    background-color: var(--wf-bg);
  }

  .l3-header {
    margin-bottom: var(--wf-space-6);
    max-width: 48rem;
  }

  .l3-title {
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .l3-card {
    border: 1px solid var(--wf-line);
    border-radius: var(--wf-radius);
    padding: var(--wf-space-5);
    background-color: var(--wf-bg);
    display: flex;
    flex-direction: column;
    gap: var(--wf-space-5);
    max-width: 48rem;
  }

  .l3-section-block {
    display: flex;
    flex-direction: column;
    gap: var(--wf-space-2);
  }

  .l3-block-title {
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.3;
    border-bottom: 1px solid var(--wf-line);
    padding-bottom: var(--wf-space-2);
    color: var(--wf-ink);
  }

  .l3-address-text {
    font-size: 0.9375rem;
    color: var(--wf-ink);
    line-height: 1.5;
  }

  .l3-city-text {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--wf-ink);
  }

  .l3-landmark-text {
    font-size: 0.8125rem;
    color: var(--wf-ink);
    font-style: italic;
    line-height: 1.4;
  }

  .l3-hours-list {
    display: flex;
    flex-direction: column;
    gap: var(--wf-space-2);
  }

  .l3-hours-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--wf-space-3);
    font-size: 0.875rem;
    border-bottom: 1px dashed var(--wf-line);
    padding-bottom: var(--wf-space-1);
  }

  .l3-hours-days {
    font-weight: 600;
  }

  .l3-hours-time {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.8125rem;
    text-align: right;
  }

  .l3-actions {
    padding-top: var(--wf-space-2);
  }

  .l3-actions .wf-btn {
    width: 100%;
  }

  /* 768px tablet layout: tombol lebar alami */
  @media (min-width: 768px) {
    .l3-actions .wf-btn {
      width: auto;
    }
  }

  /* 1280px / >=1024px desktop layout: info bertumpuk saja, tanpa peta, tombol Buka di Maps */
  @media (min-width: 1024px) {
    .l3 {
      padding-block: var(--wf-space-8);
    }

    .l3-title {
      font-size: 2rem;
    }

    .l3-card {
      padding: var(--wf-space-6);
      display: flex;
      flex-direction: column;
      gap: var(--wf-space-5);
      max-width: 48rem;
    }

    .l3-actions {
      padding-top: var(--wf-space-3);
      border-top: 1px solid var(--wf-line);
    }

    .l3-actions .wf-btn {
      width: auto;
    }
  }
</style>
