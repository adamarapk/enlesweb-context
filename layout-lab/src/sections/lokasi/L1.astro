---
import type { LokasiData } from '../../schema/lokasi';

interface Props {
  data: LokasiData;
  id?: string;
}

const { data, id = 'l1' } = Astro.props;
const isExternalMap = data.mapsUrl ? (data.mapsUrl.startsWith('http://') || data.mapsUrl.startsWith('https://')) : false;
---

<section class="wf-lokasi l1" id={id}>
  <div class="wf-container">
    <div class="l1-header">
      <h2 class="l1-title wf-break-word">{data.title}</h2>
    </div>

    {data.status === 'loading' ? (
      <div class="wf-state-indicator" role="status" aria-live="polite">
        <div class="wf-state-content">
          <span class="wf-state-mark">Memuat</span>
          <span class="wf-state-text">{data.pesanStatus || 'Sedang memuat data lokasi dan jadwal operasional...'}</span>
        </div>
      </div>
    ) : data.status === 'error' ? (
      <div class="wf-state-indicator" role="alert" aria-live="assertive">
        <div class="wf-state-content">
          <span class="wf-state-mark">Galat</span>
          <span class="wf-state-text">{data.pesanStatus || 'Gagal memuat data lokasi dan jadwal. Silakan coba muat ulang.'}</span>
        </div>
        <a href="/uji?mode=status" class="wf-btn wf-btn-secondary wf-state-action">Muat Ulang</a>
      </div>
    ) : (data.status === 'empty' || (!data.address && (!data.openingHours || data.openingHours.length === 0))) ? (
      <div class="wf-empty-state">
        <h3 class="wf-empty-title">Informasi Lokasi Belum Tersedia</h3>
        <p class="wf-empty-desc">{data.pesanStatus || 'Detail alamat dan jam operasional belum dikonfigurasi dalam sistem.'}</p>
        <a href="/uji" class="wf-btn wf-btn-secondary">Pilih Dataset Lain</a>
      </div>
    ) : (
      <div class="l1-grid">
        <div class="l1-map-col">
          <div class="l1-map-placeholder" role="img" aria-label="Area Peta Lokasi">
            <span class="l1-map-text" aria-hidden="true">Peta</span>
          </div>
        </div>

        <div class="l1-info-col">
          <div class="l1-info-card">
            {data.address && (
              <div class="l1-section-block">
                <h3 class="l1-block-title">Alamat Operasional</h3>
                <p class="l1-address-text wf-break-word">{data.address}</p>
                {data.city && <p class="l1-city-text wf-break-word">{data.city}</p>}
                {data.landmarkNote && (
                  <p class="l1-landmark-text wf-break-word">{data.landmarkNote}</p>
                )}
              </div>
            )}

            {data.openingHours && data.openingHours.length > 0 && (
              <div class="l1-section-block">
                <h3 class="l1-block-title">Jadwal Operasional</h3>
                <div class="l1-hours-list">
                  {data.openingHours.map((row) => (
                    <div class="l1-hours-row">
                      <span class="l1-hours-days wf-break-word">{row.days}</span>
                      <span class="l1-hours-time wf-break-word">{row.hours}</span>
                    </div>
                  ))}
                </div>
              </div>
            )}

            <div class="l1-actions">
              <a
                href={data.mapsUrl || '#section-lokasi'}
                target={isExternalMap ? '_blank' : undefined}
                rel={isExternalMap ? 'noopener noreferrer' : undefined}
                class="wf-btn wf-btn-primary"
                aria-label={isExternalMap ? 'Buka lokasi di Google Maps (terbuka di tab baru)' : 'Lokasi kantor'}
              >
                Buka di Maps
              </a>
            </div>
          </div>
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .l1 {
    padding-block: var(--wf-space-6);
    border-bottom: 1px solid var(--wf-line);
    background-color: var(--wf-bg);
  }

  .l1-header {
    margin-bottom: var(--wf-space-6);
    max-width: 48rem;
  }

  .l1-title {
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .l1-grid {
    display: flex;
    flex-direction: column;
    gap: var(--wf-space-5);
  }

  .l1-map-col {
    width: 100%;
  }

  .l1-map-placeholder {
    width: 100%;
    min-height: 240px;
    background-color: var(--wf-fill);
    border: 1px solid var(--wf-line);
    border-radius: var(--wf-radius);
    display: flex;
    align-items: center;
    justify-content: center;
    user-select: none;
  }

  .l1-map-text {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--wf-ink);
  }

  .l1-info-col {
    width: 100%;
  }

  .l1-info-card {
    border: 1px solid var(--wf-line);
    border-radius: var(--wf-radius);
    padding: var(--wf-space-5);
    background-color: var(--wf-bg);
    display: flex;
    flex-direction: column;
    gap: var(--wf-space-4);
  }

  .l1-section-block {
    display: flex;
    flex-direction: column;
    gap: var(--wf-space-2);
  }

  .l1-block-title {
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.3;
    border-bottom: 1px solid var(--wf-line);
    padding-bottom: var(--wf-space-1);
    color: var(--wf-ink);
  }

  .l1-address-text {
    font-size: 0.9375rem;
    color: var(--wf-ink);
    line-height: 1.5;
  }

  .l1-city-text {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--wf-ink);
  }

  .l1-landmark-text {
    font-size: 0.8125rem;
    color: var(--wf-ink);
    font-style: italic;
    line-height: 1.4;
  }

  .l1-hours-list {
    display: flex;
    flex-direction: column;
    gap: var(--wf-space-2);
  }

  .l1-hours-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--wf-space-3);
    font-size: 0.875rem;
    border-bottom: 1px dashed var(--wf-line);
    padding-bottom: var(--wf-space-1);
  }

  .l1-hours-days {
    font-weight: 600;
  }

  .l1-hours-time {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.8125rem;
    text-align: right;
  }

  .l1-actions {
    padding-top: var(--wf-space-2);
  }

  .l1-actions .wf-btn {
    width: 100%;
  }

  /* 768px tablet layout: tombol lebar alami */
  @media (min-width: 768px) {
    .l1-actions .wf-btn {
      width: auto;
    }
  }

  /* 1280px / >=1024px desktop layout: [Peta] | [Info: alamat, jam, tombol] */
  @media (min-width: 1024px) {
    .l1 {
      padding-block: var(--wf-space-8);
    }

    .l1-title {
      font-size: 2rem;
    }

    .l1-grid {
      display: grid;
      grid-template-columns: 6fr 6fr;
      gap: var(--wf-space-7);
      align-items: stretch;
    }

    .l1-map-placeholder {
      height: 100%;
      min-height: 380px;
    }

    .l1-info-card {
      padding: var(--wf-space-6);
    }

    .l1-actions .wf-btn {
      width: auto;
    }
  }
</style>
