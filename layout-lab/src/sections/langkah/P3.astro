---
import type { LangkahData } from '../../schema/langkah';

interface Props {
  data: LangkahData;
  id?: string;
}

const { data, id = 'p3' } = Astro.props;
---

<section class="wf-langkah p3" id={id}>
  <div class="wf-container">
    <div class="p3-header">
      <h2 class="p3-title wf-break-word">{data.title}</h2>
      {data.intro && <p class="p3-intro wf-break-word">{data.intro}</p>}
    </div>

    {data.status === 'loading' ? (
      <div class="wf-state-indicator" role="status" aria-live="polite">
        <div class="wf-state-content">
          <span class="wf-state-mark">Memuat</span>
          <span class="wf-state-text">{data.pesanStatus || 'Sedang memuat data tahapan alur kerja...'}</span>
        </div>
      </div>
    ) : data.status === 'error' ? (
      <div class="wf-state-indicator" role="alert" aria-live="assertive">
        <div class="wf-state-content">
          <span class="wf-state-mark">Galat</span>
          <span class="wf-state-text">{data.pesanStatus || 'Gagal memuat tahapan alur kerja. Silakan coba muat ulang.'}</span>
        </div>
        <a href="/uji?mode=status" class="wf-btn wf-btn-secondary wf-state-action">Muat Ulang</a>
      </div>
    ) : (data.status === 'empty' || !data.items || data.items.length === 0) ? (
      <div class="wf-empty-state">
        <h3 class="wf-empty-title">Belum Ada Tahapan Alur Kerja</h3>
        <p class="wf-empty-desc">{data.pesanStatus || 'Tidak ada entri tahapan alur kerja dalam konfigurasi data saat ini.'}</p>
        <a href="/uji" class="wf-btn wf-btn-secondary">Pilih Dataset Lain</a>
      </div>
    ) : (
      <div class="p3-grid">
        {data.items.map((item, index) => (
          <article class="p3-card">
            <div class="p3-num">{String(index + 1).padStart(2, '0')}</div>
            <div class="p3-card-body">
              <h3 class="p3-card-title wf-break-word">{item.title}</h3>
              <p class="p3-card-desc wf-break-word">{item.description}</p>
            </div>
          </article>
        ))}
      </div>
    )}
  </div>
</section>

<style>
  .p3 {
    padding-block: var(--wf-space-6);
    border-bottom: 1px solid var(--wf-line);
    background-color: var(--wf-bg);
  }

  .p3-header {
    margin-bottom: var(--wf-space-6);
    max-width: 48rem;
  }

  .p3-title {
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.01em;
    margin-bottom: var(--wf-space-2);
  }

  .p3-intro {
    font-size: 0.9375rem;
    color: var(--wf-ink);
    line-height: 1.6;
  }

  .p3-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--wf-space-4);
  }

  .p3-card {
    border: 1px solid var(--wf-line);
    border-radius: var(--wf-radius);
    padding: var(--wf-space-5);
    background-color: var(--wf-bg);
    display: flex;
    flex-direction: column;
    gap: var(--wf-space-3);
  }

  .p3-num {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1;
    color: var(--wf-line);
    border-bottom: 1px solid var(--wf-line);
    padding-bottom: var(--wf-space-3);
  }

  .p3-card-body {
    display: flex;
    flex-direction: column;
    gap: var(--wf-space-2);
    flex-grow: 1;
  }

  .p3-card-title {
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .p3-card-desc {
    font-size: 0.875rem;
    color: var(--wf-ink);
    line-height: 1.5;
  }

  /* 768px tablet layout: 2 columns */
  @media (min-width: 768px) {
    .p3-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--wf-space-4);
    }
  }

  /* 1280px / >=1024px desktop layout: 2x2 grid */
  @media (min-width: 1024px) {
    .p3 {
      padding-block: var(--wf-space-8);
    }

    .p3-title {
      font-size: 2rem;
    }

    .p3-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--wf-space-5);
    }

    .p3-card {
      padding: var(--wf-space-6);
    }

    .p3-num {
      font-size: 3rem;
    }
  }
</style>
