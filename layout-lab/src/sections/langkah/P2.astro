---
import type { LangkahData } from '../../schema/langkah';

interface Props {
  data: LangkahData;
  id?: string;
}

const { data, id = 'p2' } = Astro.props;
---

<section class="wf-langkah p2" id={id}>
  <div class="wf-container">
    <div class="p2-header">
      <h2 class="p2-title wf-break-word">{data.title}</h2>
      {data.intro && <p class="p2-intro wf-break-word">{data.intro}</p>}
    </div>

    {data.status === 'loading' ? (
      <div class="wf-state-indicator" role="status" aria-live="polite">
        <div class="wf-state-content">
          <span class="wf-state-mark">Memuat</span>
          <span class="wf-state-text">{data.pesanStatus || 'Sedang memuat data tahapan alur kerja...'}</span>
        </div>
      </div>
    ) : data.status === 'error' ? (
      <div class="wf-state-indicator" role="alert" aria-live="assertive">
        <div class="wf-state-content">
          <span class="wf-state-mark">Galat</span>
          <span class="wf-state-text">{data.pesanStatus || 'Gagal memuat tahapan alur kerja. Silakan coba muat ulang.'}</span>
        </div>
        <a href="/uji?mode=status" class="wf-btn wf-btn-secondary wf-state-action">Muat Ulang</a>
      </div>
    ) : (data.status === 'empty' || !data.items || data.items.length === 0) ? (
      <div class="wf-empty-state">
        <h3 class="wf-empty-title">Belum Ada Tahapan Alur Kerja</h3>
        <p class="wf-empty-desc">{data.pesanStatus || 'Tidak ada entri tahapan alur kerja dalam konfigurasi data saat ini.'}</p>
        <a href="/uji" class="wf-btn wf-btn-secondary">Pilih Dataset Lain</a>
      </div>
    ) : (
      <div class="p2-timeline">
        {data.items.map((item, index) => (
          <div class="p2-step">
            <div class="p2-marker">
              <span class="p2-num">{String(index + 1).padStart(2, '0')}</span>
            </div>
            <div class="p2-content">
              <h3 class="p2-item-title wf-break-word">{item.title}</h3>
              <p class="p2-item-desc wf-break-word">{item.description}</p>
            </div>
          </div>
        ))}
      </div>
    )}
  </div>
</section>

<style>
  .p2 {
    padding-block: var(--wf-space-6);
    border-bottom: 1px solid var(--wf-line);
    background-color: var(--wf-bg);
  }

  .p2-header {
    margin-bottom: var(--wf-space-6);
    max-width: 48rem;
  }

  .p2-title {
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.01em;
    margin-bottom: var(--wf-space-2);
  }

  .p2-intro {
    font-size: 0.9375rem;
    color: var(--wf-ink);
    line-height: 1.6;
  }

  .p2-timeline {
    position: relative;
    display: flex;
    flex-direction: column;
    padding-left: var(--wf-space-5);
    border-left: 2px solid var(--wf-line);
    margin-left: var(--wf-space-5);
    max-width: 48rem;
  }

  .p2-step {
    position: relative;
    padding-bottom: var(--wf-space-6);
    display: flex;
    flex-direction: column;
    gap: var(--wf-space-2);
  }

  .p2-step:last-child {
    padding-bottom: 0;
  }

  .p2-marker {
    position: absolute;
    left: calc(-1.125rem - 1px);
    top: 0;
    width: 2.25rem;
    height: 2.25rem;
    background-color: var(--wf-bg);
    border: 2px solid var(--wf-line);
    border-radius: var(--wf-radius);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .p2-num {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--wf-ink);
    letter-spacing: 0.02em;
  }

  .p2-content {
    background-color: var(--wf-bg);
    border: 1px solid var(--wf-line);
    border-radius: var(--wf-radius);
    padding: var(--wf-space-4);
  }

  .p2-item-title {
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: var(--wf-space-2);
  }

  .p2-item-desc {
    font-size: 0.875rem;
    color: var(--wf-ink);
    line-height: 1.5;
  }

  /* 768px tablet layout: intermediate timeline spacing */
  @media (min-width: 768px) and (max-width: 1023px) {
    .p2-timeline {
      padding-left: var(--wf-space-6);
      margin-left: var(--wf-space-6);
      max-width: 52rem;
    }
  }

  /* 1280px / >=1024px desktop layout: single vertical timeline column with expanded width */
  @media (min-width: 1024px) {
    .p2 {
      padding-block: var(--wf-space-8);
    }

    .p2-title {
      font-size: 2rem;
    }

    .p2-timeline {
      padding-left: var(--wf-space-7);
      margin-left: var(--wf-space-6);
      max-width: 56rem;
    }

    .p2-marker {
      left: calc(-1.25rem - 1px);
      width: 2.5rem;
      height: 2.5rem;
    }

    .p2-content {
      padding: var(--wf-space-5);
    }
  }
</style>
