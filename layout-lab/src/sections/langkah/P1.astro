---
import type { LangkahData } from '../../schema/langkah';

interface Props {
  data: LangkahData;
  id?: string;
}

const { data, id = 'p1' } = Astro.props;
---

<section class="wf-langkah p1" id={id}>
  <div class="wf-container">
    <div class="p1-header">
      <h2 class="p1-title wf-break-word">{data.title}</h2>
      {data.intro && <p class="p1-intro wf-break-word">{data.intro}</p>}
    </div>

    {data.status === 'loading' ? (
      <div class="wf-state-indicator" role="status" aria-live="polite">
        <div class="wf-state-content">
          <span class="wf-state-mark">Memuat</span>
          <span class="wf-state-text">{data.pesanStatus || 'Sedang memuat data tahapan alur kerja...'}</span>
        </div>
      </div>
    ) : data.status === 'error' ? (
      <div class="wf-state-indicator" role="alert" aria-live="assertive">
        <div class="wf-state-content">
          <span class="wf-state-mark">Galat</span>
          <span class="wf-state-text">{data.pesanStatus || 'Gagal memuat tahapan alur kerja. Silakan coba muat ulang.'}</span>
        </div>
        <a href="/uji?mode=status" class="wf-btn wf-btn-secondary wf-state-action">Muat Ulang</a>
      </div>
    ) : (data.status === 'empty' || !data.items || data.items.length === 0) ? (
      <div class="wf-empty-state">
        <h3 class="wf-empty-title">Belum Ada Tahapan Alur Kerja</h3>
        <p class="wf-empty-desc">{data.pesanStatus || 'Tidak ada entri tahapan alur kerja dalam konfigurasi data saat ini.'}</p>
        <a href="/uji" class="wf-btn wf-btn-secondary">Pilih Dataset Lain</a>
      </div>
    ) : (
      <div class="p1-grid">
        {data.items.map((item, index) => (
          <article class="p1-item">
            <div class="p1-num">{String(index + 1).padStart(2, '0')}</div>
            <h3 class="p1-item-title wf-break-word">{item.title}</h3>
            <p class="p1-item-desc wf-break-word">{item.description}</p>
          </article>
        ))}
      </div>
    )}
  </div>
</section>

<style>
  .p1 {
    padding-block: var(--wf-space-6);
    border-bottom: 1px solid var(--wf-line);
    background-color: var(--wf-bg);
  }

  .p1-header {
    margin-bottom: var(--wf-space-6);
    max-width: 48rem;
  }

  .p1-title {
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.01em;
    margin-bottom: var(--wf-space-2);
  }

  .p1-intro {
    font-size: 0.9375rem;
    color: var(--wf-ink);
    line-height: 1.6;
  }

  .p1-grid {
    display: flex;
    flex-direction: column;
    gap: var(--wf-space-4);
  }

  .p1-item {
    border: 1px solid var(--wf-line);
    border-radius: var(--wf-radius);
    padding: var(--wf-space-4);
    background-color: var(--wf-bg);
    display: flex;
    flex-direction: column;
    gap: var(--wf-space-2);
  }

  .p1-num {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 1rem;
    font-weight: 700;
    color: var(--wf-ink);
    border-bottom: 1px solid var(--wf-line);
    padding-bottom: var(--wf-space-2);
    margin-bottom: var(--wf-space-1);
    letter-spacing: 0.02em;
  }

  .p1-item-title {
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .p1-item-desc {
    font-size: 0.875rem;
    color: var(--wf-ink);
    line-height: 1.5;
  }

  /* 768px tablet layout: 2 columns */
  @media (min-width: 768px) {
    .p1-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--wf-space-4);
    }
  }

  /* 1280px / >=1024px desktop layout: 3 to 4 horizontal columns */
  @media (min-width: 1024px) {
    .p1 {
      padding-block: var(--wf-space-8);
    }

    .p1-title {
      font-size: 2rem;
    }

    .p1-grid {
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: var(--wf-space-5);
    }

    .p1-item {
      padding: var(--wf-space-5);
    }
  }
</style>
