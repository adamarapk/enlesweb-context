---
import type { KeunggulanData } from '../../schema/keunggulan';

interface Props {
  data: KeunggulanData;
  id?: string;
}

const { data, id = 'k1' } = Astro.props;
---

<section class="wf-keunggulan k1" id={id}>
  <div class="wf-container">
    <div class="k1-header">
      <h2 class="k1-title wf-break-word">{data.title}</h2>
      {data.intro && <p class="k1-intro wf-break-word">{data.intro}</p>}
    </div>

    {data.status === 'loading' ? (
      <div class="wf-state-indicator" role="status" aria-live="polite">
        <div class="wf-state-content">
          <span class="wf-state-mark">Memuat</span>
          <span class="wf-state-text">{data.pesanStatus || 'Sedang memuat data karakteristik keunggulan sistem...'}</span>
        </div>
      </div>
    ) : data.status === 'error' ? (
      <div class="wf-state-indicator" role="alert" aria-live="assertive">
        <div class="wf-state-content">
          <span class="wf-state-mark">Galat</span>
          <span class="wf-state-text">{data.pesanStatus || 'Gagal memuat karakteristik keunggulan. Silakan coba muat ulang.'}</span>
        </div>
        <a href="/uji?mode=status" class="wf-btn wf-btn-secondary wf-state-action">Muat Ulang</a>
      </div>
    ) : (data.status === 'empty' || !data.items || data.items.length === 0) ? (
      <div class="wf-empty-state">
        <h3 class="wf-empty-title">Belum Ada Karakteristik Keunggulan</h3>
        <p class="wf-empty-desc">{data.pesanStatus || 'Tidak ada entri karakteristik terdaftar dalam konfigurasi saat ini.'}</p>
        <a href="/uji" class="wf-btn wf-btn-secondary">Pilih Dataset Lain</a>
      </div>
    ) : (
      <div class="k1-grid">
        {data.items.map((item) => (
          <article class="k1-card">
            <div class="k1-icon-box" aria-hidden="true">Ikon</div>
            <h3 class="k1-item-title wf-break-word">{item.title}</h3>
            <p class="k1-item-desc wf-break-word">{item.description}</p>
          </article>
        ))}
      </div>
    )}
  </div>
</section>

<style>
  .k1 {
    padding-block: var(--wf-space-6);
    border-bottom: 1px solid var(--wf-line);
    background-color: var(--wf-bg);
  }

  .k1-header {
    margin-bottom: var(--wf-space-6);
    max-width: 48rem;
  }

  .k1-title {
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.01em;
    margin-bottom: var(--wf-space-2);
  }

  .k1-intro {
    font-size: 0.9375rem;
    color: var(--wf-ink);
    line-height: 1.6;
  }

  .k1-grid {
    display: flex;
    flex-direction: column;
    gap: var(--wf-space-4);
  }

  .k1-card {
    border: 1px solid var(--wf-line);
    border-radius: var(--wf-radius);
    padding: var(--wf-space-5);
    background-color: var(--wf-bg);
    display: flex;
    flex-direction: column;
    gap: var(--wf-space-2);
  }

  .k1-icon-box {
    width: 44px;
    height: 44px;
    background-color: var(--wf-fill);
    border: 1px solid var(--wf-line);
    border-radius: var(--wf-radius);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--wf-ink);
    margin-bottom: var(--wf-space-2);
    user-select: none;
  }

  .k1-item-title {
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .k1-item-desc {
    font-size: 0.875rem;
    color: var(--wf-ink);
    line-height: 1.5;
  }

  /* 768px tablet layout: 2 columns */
  @media (min-width: 768px) {
    .k1-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--wf-space-4);
    }
  }

  /* 1280px / >=1024px desktop layout: 3 columns */
  @media (min-width: 1024px) {
    .k1 {
      padding-block: var(--wf-space-8);
    }

    .k1-title {
      font-size: 2rem;
    }

    .k1-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--wf-space-5);
    }
  }
</style>
