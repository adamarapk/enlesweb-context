---
import type { KeunggulanData } from '../../schema/keunggulan';

interface Props {
  data: KeunggulanData;
  id?: string;
}

const { data, id = 'k3' } = Astro.props;
---

<section class="wf-keunggulan k3" id={id}>
  <div class="wf-container">
    <div class="k3-layout">
      <div class="k3-statement-col">
        <h2 class="k3-statement-title wf-break-word">{data.title}</h2>
        {data.intro && <p class="k3-statement-desc wf-break-word">{data.intro}</p>}
      </div>

      {data.status === 'loading' ? (
        <div class="wf-state-indicator" role="status" aria-live="polite">
          <div class="wf-state-content">
            <span class="wf-state-mark">Memuat</span>
            <span class="wf-state-text">{data.pesanStatus || 'Sedang memuat data karakteristik keunggulan sistem...'}</span>
          </div>
        </div>
      ) : data.status === 'error' ? (
        <div class="wf-state-indicator" role="alert" aria-live="assertive">
          <div class="wf-state-content">
            <span class="wf-state-mark">Galat</span>
            <span class="wf-state-text">{data.pesanStatus || 'Gagal memuat karakteristik keunggulan. Silakan coba muat ulang.'}</span>
          </div>
          <a href="/uji?mode=status" class="wf-btn wf-btn-secondary wf-state-action">Muat Ulang</a>
        </div>
      ) : (data.status === 'empty' || !data.items || data.items.length === 0) ? (
        <div class="wf-empty-state">
          <h3 class="wf-empty-title">Belum Ada Karakteristik Keunggulan</h3>
          <p class="wf-empty-desc">{data.pesanStatus || 'Tidak ada entri karakteristik terdaftar dalam konfigurasi saat ini.'}</p>
          <a href="/uji" class="wf-btn wf-btn-secondary">Pilih Dataset Lain</a>
        </div>
      ) : (
        <div class="k3-points-col">
          {data.items.map((item) => (
            <article class="k3-point-item">
              <h3 class="k3-point-title wf-break-word">{item.title}</h3>
              <p class="k3-point-desc wf-break-word">{item.description}</p>
            </article>
          ))}
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .k3 {
    padding-block: var(--wf-space-6);
    border-bottom: 1px solid var(--wf-line);
    background-color: var(--wf-bg);
  }

  .k3-layout {
    display: flex;
    flex-direction: column;
    gap: var(--wf-space-6);
  }

  .k3-statement-col {
    display: flex;
    flex-direction: column;
    gap: var(--wf-space-3);
  }

  .k3-statement-title {
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .k3-statement-desc {
    font-size: 0.9375rem;
    color: var(--wf-ink);
    line-height: 1.6;
  }

  .k3-points-col {
    display: flex;
    flex-direction: column;
    gap: var(--wf-space-4);
  }

  .k3-point-item {
    border: 1px solid var(--wf-line);
    border-radius: var(--wf-radius);
    padding: var(--wf-space-4);
    background-color: var(--wf-bg);
    display: flex;
    flex-direction: column;
    gap: var(--wf-space-1);
  }

  .k3-point-title {
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .k3-point-desc {
    font-size: 0.875rem;
    color: var(--wf-ink);
    line-height: 1.5;
  }

  /* 768px tablet layout: 2-column points */
  @media (min-width: 768px) and (max-width: 1023px) {
    .k3-points-col {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--wf-space-4);
    }
  }

  /* 1280px / >=1024px desktop layout: [title sebagai pernyataan besar] | [item sebagai poin kecil bertumpuk] */
  @media (min-width: 1024px) {
    .k3 {
      padding-block: var(--wf-space-8);
    }

    .k3-layout {
      display: grid;
      grid-template-columns: 5fr 7fr;
      gap: var(--wf-space-7);
      align-items: start;
    }

    .k3-statement-title {
      font-size: 2.25rem;
      line-height: 1.2;
    }

    .k3-statement-desc {
      font-size: 1rem;
    }

    .k3-points-col {
      gap: var(--wf-space-4);
    }

    .k3-point-item {
      padding: var(--wf-space-5);
    }
  }
</style>
