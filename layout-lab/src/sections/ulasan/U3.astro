---
import type { UlasanData } from '../../schema/ulasan';

interface Props {
  data: UlasanData;
  id?: string;
}

const { data, id = 'u3' } = Astro.props;
---

<section class="wf-ulasan u3" id={id}>
  <div class="wf-container">
    <div class="u3-header">
      <h2 class="u3-title wf-break-word">{data.title}</h2>
      {data.intro && <p class="u3-intro wf-break-word">{data.intro}</p>}
      {data.summaryNote && <p class="u3-summary-note wf-break-word">{data.summaryNote}</p>}
    </div>

    {data.status === 'loading' ? (
      <div class="wf-state-indicator" role="status" aria-live="polite">
        <div class="wf-state-content">
          <span class="wf-state-mark">Memuat</span>
          <span class="wf-state-text">{data.pesanStatus || 'Sedang memuat data ulasan...'}</span>
        </div>
      </div>
    ) : data.status === 'error' ? (
      <div class="wf-state-indicator" role="alert" aria-live="assertive">
        <div class="wf-state-content">
          <span class="wf-state-mark">Galat</span>
          <span class="wf-state-text">{data.pesanStatus || 'Gagal memuat ulasan. Silakan coba muat ulang.'}</span>
        </div>
        <a href="/uji" class="wf-btn wf-btn-secondary wf-state-action">Muat Ulang</a>
      </div>
    ) : (data.status === 'empty' || !data.items || data.items.length === 0) ? (
      <div class="wf-empty-state">
        <h3 class="wf-empty-title">Belum Ada Ulasan</h3>
        <p class="wf-empty-desc">{data.pesanStatus || 'Tidak ada entri ulasan terdaftar saat ini.'}</p>
        <a href="/uji" class="wf-btn wf-btn-secondary">Pilih Dataset Lain</a>
      </div>
    ) : (
      <div class="u3-list">
        {data.items.map((item) => (
          <article class="u3-row">
            <blockquote class="u3-quote wf-break-word">"{item.quote}"</blockquote>
            <div class="u3-author-wrap">
              <div class="u3-author wf-break-word">{item.author}</div>
              {item.context && <div class="u3-context wf-break-word">{item.context}</div>}
            </div>
          </article>
        ))}
      </div>
    )}
  </div>
</section>

<style>
  .u3 {
    padding-block: var(--wf-space-6);
    border-bottom: 1px solid var(--wf-line);
    background-color: var(--wf-bg);
  }

  .u3-header {
    margin-bottom: var(--wf-space-6);
    max-width: 48rem;
    display: flex;
    flex-direction: column;
    gap: var(--wf-space-2);
  }

  .u3-title {
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1.25;
  }

  .u3-intro {
    font-size: 0.9375rem;
    color: var(--wf-ink);
    line-height: 1.6;
  }

  .u3-summary-note {
    font-size: 0.875rem;
    color: var(--wf-ink);
    opacity: 0.85;
    font-weight: 500;
  }

  .u3-list {
    border-top: 1px solid var(--wf-line);
  }

  .u3-row {
    padding-block: var(--wf-space-5);
    border-bottom: 1px solid var(--wf-line);
    display: flex;
    flex-direction: column;
    gap: var(--wf-space-3);
  }

  .u3-quote {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--wf-ink);
    margin: 0;
  }

  .u3-author-wrap {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .u3-author {
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .u3-context {
    font-size: 0.8125rem;
    color: var(--wf-ink);
    opacity: 0.85;
    line-height: 1.4;
  }

  @media (min-width: 768px) {
    .u3-row {
      display: grid;
      grid-template-columns: 2.2fr 1fr;
      gap: var(--wf-space-6);
      align-items: start;
      padding-block: var(--wf-space-6);
    }
  }

  @media (min-width: 1024px) {
    .u3 {
      padding-block: var(--wf-space-8);
    }

    .u3-title {
      font-size: 2rem;
    }
  }
</style>
