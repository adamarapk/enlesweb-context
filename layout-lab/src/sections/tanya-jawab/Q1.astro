---
import type { TanyaJawabData } from '../../schema/tanya-jawab';

interface Props {
  data: TanyaJawabData;
  id?: string;
}

const { data, id = 'q1' } = Astro.props;
---

<section class="wf-tanya-jawab q1" id={id}>
  <div class="wf-container">
    <div class="q1-wrap">
      <div class="q1-header">
        <h2 class="q1-title wf-break-word">{data.title}</h2>
        {data.intro && <p class="q1-intro wf-break-word">{data.intro}</p>}
      </div>

      {data.status === 'loading' ? (
        <div class="wf-state-indicator" role="status" aria-live="polite">
          <div class="wf-state-content">
            <span class="wf-state-mark">Memuat</span>
            <span class="wf-state-text">{data.pesanStatus || 'Sedang memuat data tanya jawab...'}</span>
          </div>
        </div>
      ) : data.status === 'error' ? (
        <div class="wf-state-indicator" role="alert" aria-live="assertive">
          <div class="wf-state-content">
            <span class="wf-state-mark">Galat</span>
            <span class="wf-state-text">{data.pesanStatus || 'Gagal memuat tanya jawab. Silakan coba muat ulang.'}</span>
          </div>
          <a href="/uji" class="wf-btn wf-btn-secondary wf-state-action">Muat Ulang</a>
        </div>
      ) : (data.status === 'empty' || !data.items || data.items.length === 0) ? (
        <div class="wf-empty-state">
          <h3 class="wf-empty-title">Belum Ada Tanya Jawab</h3>
          <p class="wf-empty-desc">{data.pesanStatus || 'Tidak ada entri pertanyaan terdaftar saat ini.'}</p>
          <a href="/uji" class="wf-btn wf-btn-secondary">Pilih Dataset Lain</a>
        </div>
      ) : (
        <div class="q1-list">
          {data.items.map((item) => (
            <details class="q1-item">
              <summary class="q1-summary">
                <h3 class="q1-question wf-break-word">{item.question}</h3>
              </summary>
              <div class="q1-answer">
                <p class="wf-break-word">{item.answer}</p>
              </div>
            </details>
          ))}
        </div>
      )}

      {data.helperText && (
        <p class="q1-helper wf-break-word">{data.helperText}</p>
      )}
    </div>
  </div>
</section>

<style>
  .q1 {
    padding-block: var(--wf-space-6);
    border-bottom: 1px solid var(--wf-line);
    background-color: var(--wf-bg);
  }

  .q1-wrap {
    max-width: 48rem;
    margin-inline: auto;
  }

  .q1-header {
    margin-bottom: var(--wf-space-6);
  }

  .q1-title {
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1.25;
    margin-bottom: var(--wf-space-2);
  }

  .q1-intro {
    font-size: 0.9375rem;
    color: var(--wf-ink);
    line-height: 1.6;
  }

  .q1-list {
    display: flex;
    flex-direction: column;
    gap: var(--wf-space-3);
  }

  .q1-item {
    border: 1px solid var(--wf-line);
    border-radius: var(--wf-radius);
    background-color: var(--wf-bg);
  }

  .q1-summary {
    padding: var(--wf-space-4);
    cursor: pointer;
    user-select: none;
    font-size: 1rem;
    font-weight: 700;
  }

  .q1-summary:focus-visible {
    outline: 2px solid var(--wf-ink);
    outline-offset: -2px;
  }

  .q1-question {
    display: inline;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .q1-answer {
    padding: var(--wf-space-4);
    padding-top: 0;
    border-top: 1px solid var(--wf-fill);
    margin-top: var(--wf-space-2);
    font-size: 0.875rem;
    color: var(--wf-ink);
    line-height: 1.6;
  }

  .q1-helper {
    margin-top: var(--wf-space-5);
    font-size: 0.875rem;
    color: var(--wf-ink);
    opacity: 0.85;
    line-height: 1.5;
    border-left: 2px solid var(--wf-line);
    padding-left: var(--wf-space-3);
  }

  @media (min-width: 1024px) {
    .q1 {
      padding-block: var(--wf-space-8);
    }

    .q1-title {
      font-size: 2rem;
    }

    .q1-question {
      font-size: 1.0625rem;
    }
  }
</style>
